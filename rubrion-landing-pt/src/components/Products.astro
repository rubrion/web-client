---
// Products — white-label products + Rubot (the platform that wraps the agents we build)
import Specfit from '../assets/products/specfit.svg';
import Brad from '../assets/products/brad.svg';

const products = [
	{ name: 'EdgeLetter', mono: 'E', desc: 'Rode uma plataforma de newsletter e publicação com o seu nome.', chips: ['Remetente com sua marca', 'Segmentação', 'Self-host'], link: { label: 'edgeletter.rubrion.ai', href: 'https://edgeletter.rubrion.ai', external: true } },
	{ name: 'Rubrion Store', mono: 'S', desc: 'Seu próprio marketplace multivendedor, com a sua marca.', chips: ['Cadastro de vendedores', 'Busca rápida', 'Multi-inquilino'], link: { label: 'rubrion.store', href: 'https://rubrion.store', external: true } },
	{ name: 'SpecFit', mark: 'specfit', desc: 'Contratação mais inteligente: pontue qualquer currículo para a vaga.', chips: ['Pontuação de currículos', 'Lista ordenada', 'Limites justos'], link: { label: 'specfit.rubrion.ai', href: 'https://specfit.rubrion.ai', external: true } },
];
---

<section id="products" class="mx-auto w-full bg-white px-4 py-20 md:px-8 dark:bg-neutral-950">
	<h2 class="mx-auto w-fit text-center text-xl font-bold tracking-tight text-neutral-800 md:text-4xl dark:text-neutral-100">
		Produtos que você pode usar hoje
	</h2>
	<p class="mx-auto mt-4 max-w-lg text-center text-sm text-neutral-600 dark:text-neutral-400">
		Produtos prontos e funcionando que você lança com a sua marca; hospede você mesmo ou deixe que rodemos.
	</p>

	<div class="mx-auto mt-14 grid max-w-7xl grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{products.map((p) => (
			<div class="feature-card p-6">
				<div>
					<div class="flex items-center gap-3">
						<span class="product-mark text-neutral-900 dark:text-neutral-100">
							{p.mark === 'specfit'
								? <Specfit class="h-7 w-7" />
								: p.mono}
						</span>
						<h3 class="font-display text-lg font-bold tracking-tight text-neutral-900 dark:text-neutral-100">{p.name}</h3>
					</div>
					<p class="mt-3 text-sm text-neutral-600 dark:text-neutral-400">{p.desc}</p>
					<div class="mt-4 flex flex-wrap gap-2">
						{p.chips.map((c) => <span class="tag-pill">{c}</span>)}
					</div>
				</div>
				<a href={p.link.href} class="mt-6 inline-flex items-center gap-1 font-mono text-xs text-brand-500 transition hover:text-brand-400" {...(p.link.external ? { target: '_blank', rel: 'noopener' } : {})}>
					{p.link.label} {p.link.external ? '↗' : '→'}
				</a>
			</div>
		))}
	</div>

	<!-- Rubot: the platform that wraps the agents we build -->
	<div id="agents" class="mx-auto mt-12 max-w-7xl">
		<h3 class="font-mono text-xs tracking-[0.3em] text-neutral-500 uppercase">Agentes de IA</h3>
		<div class="feature-card mt-4 p-6 md:p-8">
			<div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
				<div class="max-w-md">
					<div class="flex items-center gap-3">
						<span class="product-mark"><img src="/rubot-face.png" alt="Rubot" loading="lazy" class="rubot-img h-8 w-8 object-contain" /></span>
						<div>
							<h4 class="font-display text-lg font-bold tracking-tight text-neutral-900 dark:text-neutral-100">Rubot</h4>
							<p class="font-mono text-[11px] tracking-widest text-brand-500 uppercase">Plataforma de agentes</p>
						</div>
					</div>
					<p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400">
						A plataforma onde nossos agentes rodam. Cada um é moldado ao seu contexto e implantado com a sua marca, com isolamento por inquilino e proteções.
					</p>
					<a href="mailto:ola@rubrion.com.br" class="mt-5 inline-flex items-center gap-1 font-mono text-xs text-brand-500 transition hover:text-brand-400">Adicionar um agente →</a>
				</div>

				<div class="grid w-full max-w-md grid-cols-1 gap-3 sm:grid-cols-2">
					<a href="https://brad.rubrion.ai" target="_blank" rel="noopener" class="group rounded-xl border border-line p-4 transition hover:border-brand-500/50 dark:border-line-dark">
						<div class="flex items-center gap-2">
							<Brad class="h-6 w-6 text-neutral-900 dark:text-neutral-100" />
							<span class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">Brad</span>
						</div>
						<p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">Marketing: briefings, textos para redes e banners da marca, pelo WhatsApp.</p>
						<span class="mt-3 inline-flex items-center gap-1 font-mono text-[11px] text-brand-500 transition group-hover:text-brand-400">brad.rubrion.ai ↗</span>
					</a>
					<div class="flex items-center justify-center rounded-xl border border-dashed border-line p-4 text-center text-xs text-neutral-400 dark:border-line-dark dark:text-neutral-500">
						Mais agentes a caminho
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
