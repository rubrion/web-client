---
// Page shell: head/SEO, header, footer and the page-wide scripts. Every page
// is static HTML; the interactive parts are small bundled scripts.
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import type { JsonLd } from '../data/seo';
import { DEFAULT_DESCRIPTION } from '../data/seo';
import { HTML_LANG } from '../data/locale';
import { c } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	jsonLd?: JsonLd[];
	/** Header floats transparent over a full-bleed hero (home). */
	overlay?: boolean;
	noindex?: boolean;
	/** Page has a Turnstile-protected form (contact, newsletter). */
	turnstile?: boolean;
}

const {
	title: pageTitle,
	description = DEFAULT_DESCRIPTION,
	canonical,
	ogImage,
	jsonLd,
	overlay = false,
	noindex = false,
	turnstile = false,
} = Astro.props;
const title = pageTitle ? `${pageTitle} · Rubrion` : `Rubrion, ${c.tagline}`;

// Cloudflare Turnstile loader: only with a site key, and only on pages with a
// form that uses it.
const TURNSTILE_SITE_KEY = import.meta.env.VITE_TURNSTILE_SITE_KEY as string | undefined;
---

<!doctype html>
<html lang={HTML_LANG} class="dark" style="color-scheme:dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#000000" />
		<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<Seo title={title} description={description} canonical={canonical} ogImage={ogImage} jsonLd={jsonLd} noindex={noindex} />
		<script is:inline>
			// Before first paint: theme (no flash), and motion only when JS runs and
			// reduced motion isn't requested, so hidden start states never reach a
			// static render. Arriving through a diagonal link holds the cover.
			(() => {
				const el = document.documentElement;
				try {
					const stored = localStorage.getItem('theme');
					const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
					el.classList.toggle('dark', dark);
					el.style.colorScheme = dark ? 'dark' : 'light';
				} catch (e) {}
				const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (!reduced) el.classList.add('has-motion');
				try {
					const t = Number(sessionStorage.getItem('rubrion-diagonal'));
					if (!reduced && Date.now() - t < 4000) el.classList.add('dg-arriving');
				} catch (e) {}
			})();
		</script>
		<slot name="head" />
		{
			turnstile && TURNSTILE_SITE_KEY && (
				<script is:inline>
					// Turnstile (two iframes, ~230 KB) only once a protected form is near.
					addEventListener('DOMContentLoaded', () => {
						const zones = document.querySelectorAll('#contact-form, #ep-subscribe');
						if (!zones.length) return;
						const io = new IntersectionObserver((entries) => {
							if (!entries.some((e) => e.isIntersecting)) return;
							io.disconnect();
							const s = document.createElement('script');
							s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
							s.async = true;
							s.onload = () => dispatchEvent(new Event('turnstile:ready'));
							document.head.appendChild(s);
						}, { rootMargin: '800px' });
						zones.forEach((z) => io.observe(z));
					});
				</script>
			)
		}
	</head>
	<body class="bg-white text-neutral-900 antialiased dark:bg-black dark:text-neutral-100">
		<a href="#main" class="visually-hidden focus:not-sr-only">{c.common.skip}</a>
		<Navbar overlay={overlay} />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script>
			import { initDiagonal } from '../scripts/diagonal';

			initDiagonal();
			// Motion (GSAP, Lenis) loads once the first screen has painted, so it
			// never competes with the hero image.
			const motion = () => import('../scripts/motion').then((m) => m.initMotion());
			'requestIdleCallback' in window ? requestIdleCallback(motion, { timeout: 700 }) : setTimeout(motion, 200);
		</script>
	</body>
</html>
