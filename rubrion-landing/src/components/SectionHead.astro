---
// Section heading: tracked eyebrow led by the red spark, a display title
// (its one <em> set in Unna italic), optional lead.
interface Props {
	kicker: string;
	title: string;
	lead?: string;
	center?: boolean;
	/** Heading level: h1 on a page hero, h2 inside a page. */
	as?: 'h1' | 'h2';
	class?: string;
}
const { kicker, title, lead, center = false, as: Tag = 'h2', class: cls } = Astro.props;
---

<div class:list={['max-w-3xl', center && 'mx-auto text-center', cls]}>
	<p class="eyebrow" data-reveal>{kicker}</p>
	<Tag class:list={['display mt-6 text-ink', Tag === 'h1' ? 'text-[2.7rem] md:text-7xl' : 'text-[2.2rem] md:text-[3.6rem]']} data-split set:html={title} />
	{lead && <p class:list={['lead mt-6 max-w-xl', center && 'mx-auto']} data-reveal>{lead}</p>}
</div>
