---
// Products — SaaS + white-label products + Rubot (the platform that wraps the agents we build)
import edgeletterLogo from '../assets/products/edgeletter-logo.png';
import storeLogo from '../assets/products/store-logo.png';
import curricleanLogo from '../assets/products/curriclean-logo.png';
import Brad from '../assets/products/brad-logo.svg';

const groups = [
	{ label: 'SaaS', items: [
		{ name: 'CurriClean', logo: curricleanLogo, desc: 'Smarter hiring, score any CV against the role.', chips: ['CV scoring', 'Ranked shortlist', 'Fair limits'], link: { label: 'curriclean.rubrion.ai', href: 'https://curriclean.rubrion.ai', external: true } },
	] },
	{ label: 'White-label', items: [
		{ name: 'EdgeLetter', logo: edgeletterLogo, desc: 'Run a newsletter and publishing platform under your own name.', chips: ['Branded sender', 'Segmentation', 'Self-host'], link: { label: 'edgeletter.rubrion.ai', href: 'https://edgeletter.rubrion.ai', external: true } },
		{ name: 'Rubrion Store', logo: storeLogo, desc: 'Your own multi-vendor marketplace, under your brand.', chips: ['Vendor onboarding', 'Fast search', 'Multi-tenant'], link: { label: 'rubrion.store', href: 'https://rubrion.store', external: true } },
	] },
];
---

<section id="products" class="mx-auto w-full bg-white px-4 py-20 md:px-8 dark:bg-neutral-950">
	<h2 class="mx-auto w-fit text-center text-xl font-bold tracking-tight text-neutral-800 md:text-4xl dark:text-neutral-100">
		Products you can run today
	</h2>
	<p class="mx-auto mt-4 max-w-lg text-center text-sm text-neutral-600 dark:text-neutral-400">
		Live, working products, ready to use or launched under your own brand, self-hosted or run by us.
	</p>

	<div class="mx-auto mt-14 max-w-7xl space-y-10">
		{groups.map((g) => (
			<div>
				<h3 class="font-mono text-xs tracking-[0.3em] text-neutral-500 uppercase">{g.label}</h3>
				<div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{g.items.map((p) => (
						<div class="feature-card p-6">
							<div>
								<div class="flex items-center gap-3">
									<span class="product-mark">
										<img src={p.logo.src} alt={p.name} loading="lazy" class="h-7 w-7 object-contain" />
									</span>
									<h4 class="font-display text-lg font-bold tracking-tight text-neutral-900 dark:text-neutral-100">{p.name}</h4>
								</div>
								<p class="mt-3 text-sm text-neutral-600 dark:text-neutral-400">{p.desc}</p>
								<div class="mt-4 flex flex-wrap gap-2">
									{p.chips.map((c) => <span class="tag-pill">{c}</span>)}
								</div>
							</div>
							<a href={p.link.href} class="mt-6 inline-flex items-center gap-1 font-mono text-xs text-brand-500 transition hover:text-brand-400" {...(p.link.external ? { target: '_blank', rel: 'noopener' } : {})}>
								{p.link.label} {p.link.external ? '↗' : '→'}
							</a>
						</div>
					))}
				</div>
			</div>
		))}
	</div>

	<!-- Rubot: the platform that wraps the agents we build -->
	<div id="agents" class="mx-auto mt-12 max-w-7xl">
		<h3 class="font-mono text-xs tracking-[0.3em] text-neutral-500 uppercase">AI agents</h3>
		<div class="feature-card mt-4 p-6 md:p-8">
			<div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
				<div class="max-w-md">
					<div class="flex items-center gap-3">
						<span class="product-mark"><img src="/rubot-face.png" alt="Rubot" loading="lazy" class="rubot-img h-8 w-8 object-contain" /></span>
						<div>
							<h4 class="font-display text-lg font-bold tracking-tight text-neutral-900 dark:text-neutral-100">Rubot</h4>
							<p class="font-mono text-[11px] tracking-widest text-brand-500 uppercase">Agent platform</p>
						</div>
					</div>
					<p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400">
						The platform our agents run on. Each one is shaped to your context and deployed under your brand, with per-tenant isolation and guardrails.
					</p>
					<a href="https://chat.rubrion.ai" target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-1 font-mono text-xs text-brand-500 transition hover:text-brand-400">chat.rubrion.ai ↗</a>
				</div>

				<div class="grid w-full max-w-md grid-cols-1 gap-3 sm:grid-cols-2">
					<a href="https://brad.rubrion.ai" target="_blank" rel="noopener" class="group rounded-xl border border-line p-4 transition hover:border-brand-500/50 dark:border-line-dark">
						<div class="flex items-center gap-2">
							<Brad class="h-6 w-6" />
							<span class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">Brad</span>
						</div>
						<p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">Marketing: briefs, social copy, and on-brand banners, over WhatsApp.</p>
						<span class="mt-3 inline-flex items-center gap-1 font-mono text-[11px] text-brand-500 transition group-hover:text-brand-400">brad.rubrion.ai ↗</span>
					</a>
					<div class="flex items-center justify-center rounded-xl border border-dashed border-line p-4 text-center text-xs text-neutral-400 dark:border-line-dark dark:text-neutral-500">
						More agents on the way
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
