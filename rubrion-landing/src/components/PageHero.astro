---
// Inner-page hero: the ambient shader (scripts/ambient.ts) settling in out of
// a distortion behind a breadcrumb and the page title, with the brand's
// diagonal hairline seam on its lower edge. Emits BreadcrumbList JSON-LD.
import SectionHead from './SectionHead.astro';
import { buildBreadcrumbSchema } from '../data/seo';
import { cleanPath } from '../data/locale';
import { c } from '../data/site';

interface Props {
	kicker: string;
	title: string;
	lead?: string;
	crumbs?: { label: string; href?: string }[];
}
const { kicker, title, lead, crumbs = [] } = Astro.props;
const here = cleanPath(Astro.url.pathname);
const trail = [{ label: c.nav.home, href: '/' }, ...crumbs];
const ld = buildBreadcrumbSchema(trail.map((t) => ({ name: t.label, path: t.href ?? here })));
---

<div class="relative">
	<section class="phero relative overflow-hidden bg-paper px-5 pt-36 pb-32 md:px-8 md:pt-48 md:pb-40">
		<canvas class="phero__art" data-ambient="paper" aria-hidden="true"></canvas>
		<div class="relative mx-auto max-w-7xl">
			<nav aria-label={c.common.breadcrumb} class="mb-10 text-[0.72rem] font-bold tracking-[0.14em] text-ink-faint uppercase" data-reveal>
				<ol class="flex flex-wrap items-center gap-2.5">
					{trail.map((t, i) => (
						<li class="flex items-center gap-2.5">
							{i > 0 && <span aria-hidden="true" class="opacity-50">/</span>}
							{t.href ? <a href={t.href} class="hover:text-ink">{t.label}</a> : <span class="text-ink" aria-current="page">{t.label}</span>}
						</li>
					))}
				</ol>
			</nav>
			<SectionHead as="h1" kicker={kicker} title={title} lead={lead} />
			<slot />
		</div>
	</section>
	<svg class="phero__seam" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><line x1="0" y1="100" x2="100" y2="0" /></svg>
</div>

<script type="application/ld+json" set:html={JSON.stringify(ld)} />

<style>
	.phero {
		clip-path: polygon(0 0, 100% 0, 100% calc(100% - 4rem), 0 100%);
	}
	.phero__art {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	.phero__seam {
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 4rem;
		overflow: visible;
		pointer-events: none;
	}
	.phero__seam line {
		stroke: var(--color-brand-500);
		stroke-width: 1px;
		vector-effect: non-scaling-stroke;
	}
</style>
