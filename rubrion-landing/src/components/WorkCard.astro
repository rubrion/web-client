---
// One project: screenshot (or drawn mockup for anonymised work), then credit
// and kind, name, summary and services as quiet text. Links to its case page.
import Mockup from './Mockup.astro';
import { l } from '../data/locale';
import { c } from '../data/site';
import { credits, type Work } from '../data/work';

interface Props {
	work: Work;
	index?: number;
	large?: boolean;
}
const { work: w, index = 0, large = false } = Astro.props;
---

<a href={`/work/${w.slug}`} class="group block">
	<div class:list={['relative overflow-hidden rounded-md bg-surface-2', large ? 'aspect-[16/10]' : 'aspect-[4/3]']}>
		{w.image ? (
			<img
				src={`/work/${w.image}-900.webp`}
				alt={l(w.name)}
				width="900"
				height="506"
				loading="lazy"
				decoding="async"
				class="h-full w-full object-cover object-top transition duration-[900ms] ease-[cubic-bezier(.22,1,.36,1)] group-hover:scale-[1.03]"
			/>
		) : (
			<Mockup kind={w.mock ?? 'site'} seed={index + 1} />
		)}
	</div>
	<p class="meta mt-5">{credits[w.credit].name} · {l(w.kind)}</p>
	<h3 class:list={['display mt-2 flex items-baseline justify-between gap-4', large ? 'text-[1.75rem]' : 'text-[1.4rem]']}>
		<span>{l(w.name)}</span>
		<span class="text-base text-ink-faint transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-brand-500" aria-hidden="true">↗</span>
	</h3>
	<p class="mt-2 line-clamp-2 max-w-lg text-[0.92rem]/6 text-ink-soft">{l(w.summary)}</p>
	<p class="mt-3 text-[0.78rem] text-ink-faint">{w.services.map((s) => c.services.items[s][0]).join(' · ')}</p>
</a>
