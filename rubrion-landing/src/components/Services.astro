---
// Services as an editorial index, not a card grid: the heading holds still on
// the left while the seven services run down the right, each a numbered row
// on a hairline. Hovering a row draws its rule in red.
import SectionHead from './SectionHead.astro';
import ServiceIcon from './ServiceIcon.astro';
import { c } from '../data/site';
import type { Service } from '../data/work';

const items = Object.entries(c.services.items) as [Service, [string, string]][];
---

<section id="services" class="bg-paper px-5 py-28 md:px-8 md:py-40">
	<div class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-24">
		<div class="lg:sticky lg:top-32 lg:self-start">
			<SectionHead kicker={c.services.kicker} title={c.services.title} lead={c.services.lead} />
			<a href="#contact" class="btn btn--ink mt-10" data-reveal>{c.nav.cta}</a>
		</div>
		<ol class="border-t border-hair">
			{items.map(([key, [name, text]], i) => (
				<li class="svc group" data-reveal>
					<span class="svc__num">{String(i + 1).padStart(2, '0')}</span>
					<div>
						<h3 class="display text-2xl md:text-[1.9rem]">{name}</h3>
						<p class="mt-2 max-w-md text-[0.95rem]/7 text-ink-soft">{text}</p>
					</div>
					<ServiceIcon name={key} class="svc__icon h-6 w-6" />
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	.svc {
		position: relative;
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr) auto;
		align-items: start;
		gap: 1rem;
		padding: 2rem 0;
		border-bottom: 1px solid var(--hair);
	}

	.svc::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 1px;
		background: var(--color-brand-500);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.svc:hover::after {
		transform: scaleX(1);
	}

	.svc__num {
		padding-top: 0.55rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: var(--ink-faint);
	}

	.svc :global(.svc__icon) {
		margin-top: 0.35rem;
		color: var(--ink-faint);
		transition:
			color 0.3s ease,
			transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.svc:hover :global(.svc__icon) {
		color: var(--color-brand-500);
		transform: translateX(-4px);
	}
</style>
