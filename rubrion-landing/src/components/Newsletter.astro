---
// Newsletter row. Posts to this site's /api/subscribe (worker/index.ts),
// which checks Turnstile and hands the address to EdgeLetter, where posts are
// written and sent (double opt-in).
import { c } from '../data/site';

const n = c.newsletter;
// The "edgepress" Turnstile widget (rubrion.ai, rubrion.com.br), whose secret
// the Worker holds.
const TURNSTILE_SITE_KEY = '0x4AAAAAADMKgjDCOeL0zVJj';
---

<div id="newsletter" class="relative mx-auto max-w-7xl border-t border-hair pt-14">
	<div class="grid gap-10 md:grid-cols-2 md:items-end">
		<div>
			<h3 class="display text-3xl md:text-[2.4rem]">{n.title}</h3>
			<p class="lead mt-4 max-w-md !text-[0.95rem]">{n.lead}</p>
		</div>

		<div class="nl-box relative" data-nl-box>
		<form id="ep-subscribe" class="nl-form flex flex-col gap-3">
			<div class="flex flex-col gap-4 sm:flex-row sm:items-end">
				<label for="ep-email" class="sr-only">{n.email}</label>
				<input
					id="ep-email"
					name="email"
					type="email"
					required
					autocomplete="email"
					placeholder={n.placeholder}
					class="input sm:flex-1"
				/>
				<button type="submit" class="nl-btn btn btn--ink shrink-0 justify-center disabled:opacity-50">
					<span class="form-spinner" aria-hidden="true"></span>
					<svg class="nl-tick" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5"></path></svg>
					<span data-label>{n.submit}</span>
				</button>
			</div>

			{/* Honeypot — bots fill it, humans never see it */}
			<input
				type="text"
				name="website"
				tabindex="-1"
				autocomplete="off"
				aria-hidden="true"
				class="!absolute !-left-[9999px] !h-px !w-px !opacity-0"
			/>

			{TURNSTILE_SITE_KEY && (
				<div class="cf-turnstile max-w-full overflow-hidden" data-sitekey={TURNSTILE_SITE_KEY} data-theme="auto" data-size="flexible" />
			)}

			<p id="ep-status" role="status" aria-live="polite" class="nl-status min-h-[1.25rem] text-sm text-ink-soft"></p>
		</form>

		<div class="nl-sent" role="status" aria-live="polite" data-nl-sent>
			<svg class="nl-env" viewBox="0 0 64 48" aria-hidden="true">
				<rect class="nl-env__body" x="2" y="6" width="60" height="40" rx="5"></rect>
				<path class="nl-env__flap" d="M3 9l29 21L61 9"></path>
				<path class="nl-env__seal" d="M27.5 31.6q.9-1.6 2.7-1.6h3.6q1.8 0 2.7 1.6l1 1.7q1 1.8-.4 3.3l-3.8 4.2q-1.3 1.4-2.6 0l-3.8-4.2q-1.4-1.5-.4-3.3Z"></path>
			</svg>
			<div>
				<p class="display text-[1.5rem] leading-tight" data-nl-title></p>
				<p class="mt-2 text-[0.95rem]/7 text-ink-soft" data-nl-text></p>
				<button type="button" class="link-arrow link-arrow--in mt-4" data-nl-again>{n.again}</button>
			</div>
		</div>
		</div>
	</div>
</div>

<script is:inline define:vars={{ n }}>
	(function () {
		var f = document.getElementById('ep-subscribe');
		if (!f) return;
		var box = document.querySelector('[data-nl-box]');
		document.querySelector('[data-nl-again]').addEventListener('click', function () {
			box.classList.remove('is-sent');
			btn.classList.remove('is-done');
			label.textContent = n.submit;
			say('');
			document.getElementById('ep-email').focus({ preventScroll: true });
		});
		var st = document.getElementById('ep-status');
		var btn = f.querySelector('button[type=submit]');
		var label = btn.querySelector('[data-label]');
		// Each new status line slides in; errors read in red.
		var say = function (text, kind) {
			st.textContent = text;
			st.dataset.kind = kind || '';
			st.classList.remove('is-in');
			void st.offsetWidth;
			st.classList.add('is-in');
		};
		var busy = function (on) {
			btn.disabled = on;
			btn.classList.toggle('is-busy', on);
			label.textContent = on ? n.submitting : n.submit;
		};
		// Typing a new address puts the button back to "Subscribe".
		f.addEventListener('input', function () {
			if (!btn.classList.contains('is-done')) return;
			btn.classList.remove('is-done');
			label.textContent = n.submit;
		});
		f.addEventListener('submit', function (e) {
			e.preventDefault();
			var fd = new FormData(f);
			var body = { email: fd.get('email'), website: fd.get('website') || '' };
			var t = fd.get('cf-turnstile-response');
			if (t) body.turnstile = t;
			say('');
			busy(true);
			fetch('/api/subscribe', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(body),
			})
				.then(function (r) {
					return r.json().then(function (j) {
						return { ok: r.ok, j: j };
					});
				})
				.then(function (o) {
					busy(false);
					if (!o.ok) {
						say(n.error, 'error');
						return;
					}
					btn.classList.add('is-done');
					label.textContent = n.done;
					say(o.j.alreadyActive ? n.already : n.confirm, 'ok');
					// The form steps aside for a card that says what happens next.
					var email = String(body.email || '');
					var sent = document.querySelector('[data-nl-sent]');
					sent.querySelector('[data-nl-title]').textContent = o.j.alreadyActive ? n.alreadyTitle : n.sentTitle;
					sent.querySelector('[data-nl-text]').textContent = (o.j.alreadyActive ? n.alreadyText : n.sentText).replace('{email}', email);
					box.classList.toggle('is-already', !!o.j.alreadyActive);
					box.classList.add('is-sent');
					f.reset();
					// Reset this form's widget, not the contact form's.
					var w = f.querySelector('.cf-turnstile');
					if (window.turnstile && w) {
						try {
							window.turnstile.reset(w);
						} catch (_) {}
					}
				})
				.catch(function () {
					busy(false);
					say(n.network, 'error');
				});
		});
	})();
</script>

<style>
	/* Sent: the form lifts away and a card rises with an envelope that draws
	   itself, then a ruby seal pops on. Stays until "Use another address". */
	.nl-form {
		transition:
			opacity 0.45s ease,
			transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
			filter 0.45s ease,
			visibility 0s linear 0s;
	}

	.nl-box.is-sent .nl-form {
		opacity: 0;
		transform: translateY(-12px) scale(0.98);
		filter: blur(5px);
		visibility: hidden;
		pointer-events: none;
		transition-delay: 0s, 0s, 0s, 0.6s;
	}

	.nl-sent {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 1.25rem 1.4rem;
		border: 1px solid var(--hair);
		border-radius: 0.9rem;
		background: var(--surface);
		box-shadow: 0 24px 48px -30px rgba(20, 20, 19, 0.4);
		opacity: 0;
		transform: translateY(16px);
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 0.5s ease,
			transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s linear 0.7s;
	}

	.nl-box.is-sent .nl-sent {
		opacity: 1;
		transform: none;
		visibility: visible;
		pointer-events: auto;
		transition-delay: 0.2s, 0.2s, 0s;
	}

	.nl-env {
		flex: none;
		width: 4.2rem;
		height: auto;
		overflow: visible;
		fill: none;
		stroke: var(--ink);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.nl-env__body,
	.nl-env__flap {
		stroke-dasharray: 220;
		stroke-dashoffset: 220;
	}

	.nl-env__seal {
		fill: var(--color-brand-500);
		stroke: none;
		transform-box: fill-box;
		transform-origin: center;
		transform: scale(0);
	}

	.nl-box.is-sent .nl-env__body {
		transition: stroke-dashoffset 0.9s cubic-bezier(0.65, 0, 0.35, 1) 0.45s;
		stroke-dashoffset: 0;
	}

	.nl-box.is-sent .nl-env__flap {
		transition: stroke-dashoffset 0.6s cubic-bezier(0.65, 0, 0.35, 1) 1.1s;
		stroke-dashoffset: 0;
	}

	.nl-box.is-sent .nl-env__seal {
		animation: nl-seal 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.6s forwards;
	}

	@keyframes nl-seal {
		to {
			transform: scale(1);
		}
	}

	/* Already subscribed: no envelope to send, the seal is already on. */
	.nl-box.is-already .nl-env__seal {
		animation-delay: 0.6s;
	}

	@media (max-width: 640px) {
		.nl-sent {
			align-items: flex-start;
		}

		.nl-env {
			width: 3.2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nl-form,
		.nl-sent,
		.nl-box.is-sent .nl-env__body,
		.nl-box.is-sent .nl-env__flap {
			transition: none;
		}

		.nl-box.is-sent .nl-env__seal {
			animation: none;
			transform: scale(1);
		}
	}

	.nl-tick {
		display: none;
		width: 1em;
		height: 1em;
		margin-right: 0.45em;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.nl-tick path {
		stroke-dasharray: 16;
		stroke-dashoffset: 16;
	}

	.nl-btn.is-done .nl-tick {
		display: inline-block;
	}

	.nl-btn.is-done .nl-tick path {
		animation: nl-draw 0.45s cubic-bezier(0.65, 0, 0.35, 1) forwards;
	}

	@keyframes nl-draw {
		to {
			stroke-dashoffset: 0;
		}
	}

	.nl-status.is-in {
		animation: nl-in 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.nl-status[data-kind='error'] {
		color: var(--color-brand-500);
	}

	@keyframes nl-in {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nl-status.is-in,
		.nl-btn.is-done .nl-tick path {
			animation: none;
			stroke-dashoffset: 0;
		}
	}
</style>
