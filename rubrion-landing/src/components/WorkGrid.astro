---
// The home page's work teaser: the first n cases, two to a row and large.
// The full, grouped catalogue is /work (WorkCatalog.astro).
import WorkCard from './WorkCard.astro';
import { work } from '../data/work';

interface Props {
	limit?: number;
}
const { limit = 6 } = Astro.props;
---

<ul class="mt-12 grid grid-cols-1 gap-x-8 gap-y-16 md:grid-cols-2">
	{work.slice(0, limit).map((w, i) => (
		<li data-reveal>
			<WorkCard work={w} index={i} large />
		</li>
	))}
</ul>
