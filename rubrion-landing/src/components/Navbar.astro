---
// Fixed header: logo, main links, language switch, theme toggle, CTA. Over the
// home hero it starts transparent (white text) and turns solid once the hero
// is behind it; everywhere it hides while reading down and comes back on any
// scroll up (headroom).
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { cleanPath } from '../data/locale';
import { c, pages } from '../data/site';

interface Props {
	overlay?: boolean;
}

const { overlay = false } = Astro.props;
const here = cleanPath(Astro.url.pathname);
const current = (href: string) => !href.includes('#') && (here === href || here.startsWith(href + '/'));
---

<header
	class:list={[
		'site-header fixed inset-x-0 top-0 z-50 text-ink',
		overlay ? 'is-overlay' : 'is-solid',
	]}
	data-header
	data-overlay={overlay ? '' : undefined}
>
	<div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 md:h-[4.5rem] md:px-8">
		<Logo />

		<nav class="hidden items-center gap-1 text-[0.86rem] font-bold lg:flex" aria-label={c.nav.primary}>
			{pages.map((p) => (
				<a
					href={p.href}
					data-diagonal
					aria-current={current(p.href) ? 'page' : undefined}
					class="relative px-3.5 py-2 opacity-75 transition hover:opacity-100 aria-[current=page]:opacity-100 aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-3.5 aria-[current=page]:after:bottom-0.5 aria-[current=page]:after:h-px aria-[current=page]:after:bg-brand-500"
				>{c.nav[p.key]}</a>
			))}
		</nav>

		<div class="flex items-center gap-1.5">
			<LanguageSwitcher />
			<button data-theme-toggle type="button" aria-label={c.nav.theme} class="relative flex h-9 w-9 cursor-pointer items-center justify-center rounded-xl opacity-75 transition hover:opacity-100">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2m-7.07-17.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
			</button>
			<a href="/#contact" data-diagonal class="ml-2 hidden rounded-[0.25rem] border border-current/30 px-4 py-2.5 text-[0.82rem] font-bold transition hover:border-current md:inline-block">{c.nav.cta}</a>
			<button
				type="button"
				data-menu-button
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label={c.nav.menu}
				data-open-label={c.nav.menu}
				data-close-label={c.nav.close}
				class="flex h-10 w-10 cursor-pointer items-center justify-center lg:hidden"
			>
				<svg data-menu-open xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
				<svg data-menu-close class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"></path></svg>
			</button>
		</div>
	</div>

	<div id="mobile-menu" class="mx-4 hidden rounded-lg border border-hair bg-surface p-4 text-ink shadow-soft lg:hidden">
		<nav class="flex flex-col" aria-label={c.nav.primary}>
			{pages.map((p) => (
				<a href={p.href} data-diagonal class="border-b border-hair px-2 py-3 font-display text-lg font-semibold tracking-tight last:border-0">{c.nav[p.key]}</a>
			))}
		</nav>
		<a href="/#contact" data-diagonal class="btn btn--ink mt-4 w-full justify-between">{c.nav.cta}</a>
	</div>
</header>

<script is:inline>
	(() => {
		// Theme toggle.
		document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const el = document.documentElement;
				const dark = !el.classList.contains('dark');
				el.classList.toggle('dark', dark);
				el.style.colorScheme = dark ? 'dark' : 'light';
				try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
			});
		});

		const header = document.querySelector('[data-header]');
		const menu = document.getElementById('mobile-menu');
		const btn = document.querySelector('[data-menu-button]');
		if (!header) return;
		const overlay = header.hasAttribute('data-overlay');
		const menuOpen = () => menu && !menu.classList.contains('hidden');

		// Headroom + overlay → solid. One rAF per scroll burst.
		let last = scrollY;
		let ticking = false;
		const apply = () => {
			ticking = false;
			const y = scrollY;
			if (overlay) {
				const hero = document.querySelector('[data-hero]');
				const edge = hero ? hero.offsetHeight - header.offsetHeight : 80;
				header.classList.toggle('is-solid', y > edge || menuOpen());
			}
			if (y < 80 || menuOpen()) header.classList.remove('is-away');
			else if (Math.abs(y - last) > 6) header.classList.toggle('is-away', y > last);
			last = y;
		};
		apply();
		addEventListener('scroll', () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(apply);
		}, { passive: true });

		// Mobile menu.
		if (!menu || !btn) return;
		const setOpen = (open) => {
			menu.classList.toggle('hidden', !open);
			btn.setAttribute('aria-expanded', String(open));
			btn.setAttribute('aria-label', open ? btn.dataset.closeLabel : btn.dataset.openLabel);
			btn.querySelector('[data-menu-open]').classList.toggle('hidden', open);
			btn.querySelector('[data-menu-close]').classList.toggle('hidden', !open);
			apply();
		};
		btn.addEventListener('click', () => setOpen(!menuOpen()));
		menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
		document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
	})();
</script>
