---
// FAQ on native <details> (no JS). Questions live in site.ts and feed the
// FAQPage JSON-LD too (seo.ts), so the two never drift.
import SectionHead from './SectionHead.astro';
import { FAQS as faqs } from '../data/seo';
import { c } from '../data/site';

interface Props {
	/** Render the heading (off when a PageHero already titles the page). */
	head?: boolean;
}
const { head = true } = Astro.props;
---

<section id="faq" class:list={['bg-paper px-5 md:px-8', head ? 'py-28 md:py-40' : 'pt-6 pb-28 md:pb-40']}>
	<div class:list={['mx-auto max-w-7xl', head && 'grid gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-24']}>
		{head && <SectionHead kicker={c.faq.kicker} title={c.faq.title} lead={c.faq.lead} />}
		<div class:list={['border-t border-hair', !head && 'mx-auto max-w-3xl']}>
			{faqs.map((f, i) => (
				<details class="faq-item border-b border-hair" open={i === 0} data-reveal>
					<summary class="flex cursor-pointer items-start justify-between gap-6 py-7">
						<span class="display text-xl md:text-[1.45rem]">{f.q}</span>
						<span class="faq-plus mt-1 text-xl leading-none text-ink-faint" aria-hidden="true">+</span>
					</summary>
					<p class="max-w-2xl pb-8 text-[0.98rem]/7 text-ink-soft">{f.a}</p>
				</details>
			))}
		</div>
	</div>
</section>
