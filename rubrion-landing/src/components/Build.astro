---
// How we build: the bento. An AI agent pipeline, managed hosting (red globe,
// loaded only when it scrolls near), a custom build that reflows desktop ↔
// mobile, and the numbers. Every looping animation here pauses off-screen.
import SectionHead from './SectionHead.astro';
import CustomBuildDevice from './CustomBuildDevice.astro';
import Roller from './Roller.astro';
import { c } from '../data/site';
import { credits, work } from '../data/work';

const facts = [
	{ value: String(work.length), label: c.facts.items[0][0] },
	{ value: '3', label: c.facts.items[1][0] },
	{ value: String(Object.keys(credits).length - 1), label: c.facts.items[2][0] },
	{ value: '0', label: c.facts.items[3][0] },
];
---

<section id="build" class="overflow-hidden bg-paper px-5 py-28 md:px-8 md:py-40">
	<div class="mx-auto max-w-7xl">
		<SectionHead kicker={c.build.kicker} title={c.build.title} />
		<div class="mt-16 grid grid-cols-1 gap-4 md:auto-rows-[minmax(26rem,auto)] md:grid-cols-5">
				<div id="agents" class="feature-card group md:col-span-3" data-reveal data-idle>
			<div class="relative min-h-56 w-full flex-1 overflow-hidden">
				<div class="relative flex h-full w-full items-center justify-center">
					<svg width="128" height="69" viewBox="0 0 128 69" fill="none" class="absolute -top-6 left-1/2 -translate-x-[90%] text-hair">
						<path d="M1 0.5L1 29.586C1 36.214 6.373 41.586 13 41.586H115C121.627 41.586 127 46.959 127 53.586L127 75" stroke="currentColor" stroke-width="1"></path>
						<path d="M1 0.5L1 29.586C1 36.214 6.373 41.586 13 41.586H115C121.627 41.586 127 46.959 127 53.586L127 75" stroke="url(#grad-r2)" stroke-width="1"></path>
						<defs>
							<linearGradient id="grad-r2" x1="0%" y1="0%" x2="0%" y2="0%">
								<animate attributeName="x1" values="0%;100%" dur="4.5s" repeatCount="indefinite" />
								<animate attributeName="y1" values="0%;90%" dur="4.5s" repeatCount="indefinite" />
								<animate attributeName="x2" values="0%;120%" dur="4.5s" repeatCount="indefinite" />
								<animate attributeName="y2" values="0%;120%" dur="4.5s" repeatCount="indefinite" />
								<stop stop-color="#7a0a0a" stop-opacity="0"></stop>
								<stop offset="1" stop-color="#ff5a5a"></stop>
								<stop offset="1" stop-color="#ff5a5a" stop-opacity="0"></stop>
							</linearGradient>
						</defs>
					</svg>
					<svg width="62" height="105" viewBox="0 0 62 105" fill="none" class="absolute -bottom-2 left-1/2 text-hair">
						<path d="M1 -69L1 57.5C1 64.127 6.373 69.5 13 69.5H49C55.627 69.5 61 74.873 61 81.5L61 105" stroke="currentColor" stroke-width="1"></path>
						<path d="M1 -69L1 57.5C1 64.127 6.373 69.5 13 69.5H49C55.627 69.5 61 74.873 61 81.5L61 105" stroke="url(#grad-r1)" stroke-width="1"></path>
						<defs>
							<linearGradient id="grad-r1" x1="0%" y1="0%" x2="0%" y2="0%">
								<animate attributeName="x1" values="0%;100%" dur="6.2s" repeatCount="indefinite" />
								<animate attributeName="y1" values="0%;90%" dur="6.2s" repeatCount="indefinite" />
								<animate attributeName="x2" values="0%;120%" dur="6.2s" repeatCount="indefinite" />
								<animate attributeName="y2" values="0%;120%" dur="6.2s" repeatCount="indefinite" />
								<stop stop-color="#7a0a0a" stop-opacity="0"></stop>
								<stop offset="1" stop-color="#ff5a5a"></stop>
								<stop offset="1" stop-color="#ff5a5a" stop-opacity="0"></stop>
							</linearGradient>
						</defs>
					</svg>
					<div class="deploy-grid relative z-30 mx-auto grid w-full max-w-lg grid-cols-1 gap-4 p-8 [perspective:1000px] [transform-style:preserve-3d] sm:p-0 md:grid-cols-3">
						<div class="card-nod relative flex h-14 w-full flex-col items-center justify-center gap-2 rounded-lg border border-hair bg-paper p-2 shadow-soft md:h-40">
							<svg viewBox="0 0 24 24" class="h-8 w-8 text-ink-soft" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="1.5"></rect><rect x="3" y="14" width="18" height="6" rx="1.5"></rect><path d="M7 7h.01M7 17h.01"></path></svg>
							<p class="text-[9px] tracking-wide text-ink-faint">{c.build.infra}</p>
						</div>
						<div class="card-nod relative flex h-14 w-full flex-col items-center justify-center gap-2 rounded-lg border border-hair bg-paper p-2 shadow-soft md:h-40">
							<img src="/logos/rubot.webp" alt="Rubot" width="80" height="80" loading="lazy" class="rubot-img h-8 w-8 object-contain md:h-20 md:w-20" />
							<p class="text-[9px] tracking-wide text-ink-faint">Rubot</p>
						</div>
						<div class="card-nod relative flex h-14 w-full flex-col items-center justify-center gap-2 rounded-lg border border-hair bg-paper p-2 shadow-soft md:h-40">
							<svg viewBox="0 0 24 24" class="h-8 w-8 text-brand-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8Z"></path></svg>
							<p class="text-[9px] tracking-wide text-ink-faint">{c.build.automation}</p>
						</div>
					</div>
				</div>
			</div>
			<div class="p-6">
				<h3 class="display text-[1.35rem]">{c.build.agentTitle}</h3>
				<p class="mt-3 max-w-sm text-[0.95rem]/7 text-ink-soft">{c.build.agentText}</p>
			</div>
		</div>

			<div class="feature-card group md:col-span-2" data-reveal>
				<div class="p-6">
					<h3 class="display text-[1.35rem]">{c.build.hostTitle}</h3>
					<p class="mt-3 max-w-xs text-[0.95rem]/7 text-ink-soft">{c.build.hostText}</p>
				</div>
				<div class="relative min-h-64 w-full flex-1 overflow-hidden">
					<div class="relative h-64 w-full md:h-full">
						<canvas id="edge-globe" class="globe-canvas absolute -right-12 -bottom-40 md:-right-20 md:-bottom-40" aria-hidden="true"></canvas>
					</div>
				</div>
			</div>

			<div class="feature-card group md:col-span-3" data-reveal>
				<div class="p-6">
					<h3 class="display text-[1.35rem]">{c.build.customTitle}</h3>
					<p class="mt-3 max-w-md text-[0.95rem]/7 text-ink-soft">{c.build.customText}</p>
				</div>
				<CustomBuildDevice />
			</div>

			<div class="feature-card relative md:col-span-2" data-reveal>
				<div class="grid h-full grid-cols-2">
					{facts.map((f, i) => (
						<div class:list={['flex flex-col justify-end p-6', i % 2 === 0 && 'border-r border-hair', i < 2 && 'border-b border-hair']}>
							<Roller value={f.value} class="display text-5xl md:text-6xl" />
							<p class="meta mt-3">{f.label}</p>
						</div>
					))}
				</div>
				
			</div>
		</div>
	</div>
</section>

<script>
	// Pause the agent card's looping animations (SVG gradients, card nod)
	// whenever it's off-screen.
	document.querySelectorAll<HTMLElement>('[data-idle]').forEach((card) => {
		const svgs = card.querySelectorAll('svg');
		new IntersectionObserver(([e]) => {
			card.classList.toggle('is-idle', !e.isIntersecting);
			svgs.forEach((s) => (e.isIntersecting ? s.unpauseAnimations() : s.pauseAnimations()));
		}).observe(card);
	});

	// Red-marker globe: cobe is only fetched once the card comes near the
	// viewport, spun only while visible, and rebuilt on a theme switch.
	let canvas = document.getElementById('edge-globe') as HTMLCanvasElement | null;
	if (canvas) {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const card = canvas.parentElement!;
		let onScreen = false;
		let globe: { update(o: object): void; destroy(): void } | null = null;
		let phi = 0;
		let raf = 0;
		const tick = () => {
			phi += 0.008;
			globe?.update({ phi });
			raf = requestAnimationFrame(tick);
		};
		const start = () => {
			if (!raf && globe && !reduce && !document.hidden && onScreen) raf = requestAnimationFrame(tick);
		};
		const stop = () => {
			cancelAnimationFrame(raf);
			raf = 0;
		};
		// cobe bakes the colours in, so a theme switch gets a fresh globe on a
		// fresh canvas (a destroyed globe's WebGL context can't be reused).
		const build = (createGlobe: typeof import('cobe').default) => {
			stop();
			globe?.destroy();
			const fresh = canvas!.cloneNode() as HTMLCanvasElement;
			canvas!.replaceWith(fresh);
			canvas = fresh;
			const dark = document.documentElement.classList.contains('dark');
			// Size the backing store from the real CSS box, not a fixed 1200 @2x.
			const cssSize = fresh.clientWidth || 440;
			globe = createGlobe(fresh, {
				devicePixelRatio: Math.min(window.devicePixelRatio || 1, 2),
				width: cssSize,
				height: cssSize,
				phi,
				theta: -0.2, // tilt so Brazil faces the viewer
				// Paper globe on the light theme, graphite on dark; red markers on both.
				dark: dark ? 1 : 0,
				diffuse: dark ? 1.2 : 1.6,
				mapSamples: 12000,
				mapBrightness: dark ? 4 : 1.4,
				baseColor: dark ? [0.16, 0.16, 0.15] : [0.98, 0.97, 0.95],
				markerColor: [0.9, 0.2, 0.2],
				glowColor: dark ? [0.2, 0.2, 0.19] : [0.95, 0.94, 0.92],
				markerElevation: 0,
				markers: [
					{ location: [-23.5505, -46.6333], size: 0.055 }, // São Paulo
					{ location: [50.1109, 8.6821], size: 0.04 }, // Europe-West (Frankfurt)
					{ location: [38.9072, -77.0369], size: 0.04 }, // US-East (Ashburn)
				],
			});
			globe.update({ phi });
			start();
		};
		let booted = false;
		const boot = async () => {
			booted = true;
			const { default: createGlobe } = await import('cobe');
			build(createGlobe);
			let dark = document.documentElement.classList.contains('dark');
			new MutationObserver(() => {
				const now = document.documentElement.classList.contains('dark');
				if (now !== dark) {
					dark = now;
					build(createGlobe);
				}
			}).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
		};
		new IntersectionObserver(
			([e]) => {
				onScreen = e.isIntersecting;
				if (onScreen && !booted) boot();
				onScreen ? start() : stop();
			},
			{ rootMargin: '200px' },
		).observe(card);
		document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
	}
</script>
