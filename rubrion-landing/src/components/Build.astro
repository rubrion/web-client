---
// How we build: the bento. An AI agent pipeline, managed hosting (red globe,
// loaded only when it scrolls near), a custom build that reflows desktop ↔
// mobile, and the numbers. Every looping animation here pauses off-screen.
import SectionHead from './SectionHead.astro';
import CustomBuildDevice from './CustomBuildDevice.astro';
import Roller from './Roller.astro';
import { c } from '../data/site';
import { credits, work } from '../data/work';

const facts = [
	{ value: String(work.length), label: c.facts.items[0][0] },
	{ value: '3', label: c.facts.items[1][0] },
	{ value: String(Object.keys(credits).length - 1), label: c.facts.items[2][0] },
	{ value: '0', label: c.facts.items[3][0] },
];
---

<section id="build" class="bg-glow overflow-hidden bg-neutral-50 px-4 py-24 md:px-8 md:py-32 dark:bg-black">
	<div class="mx-auto max-w-7xl">
		<SectionHead kicker={c.build.kicker} title={c.build.title} />
		<div class="mt-14 grid grid-cols-1 gap-4 md:auto-rows-[25rem] md:grid-cols-5">
				<div id="agents" class="feature-card group md:col-span-3" data-reveal data-idle>
			<div class="relative h-full w-full overflow-hidden">
				<div class="relative flex h-full w-full items-center justify-center">
					<svg width="128" height="69" viewBox="0 0 128 69" fill="none" class="absolute -top-6 left-1/2 -translate-x-[90%] text-neutral-200 dark:text-neutral-800">
						<path d="M1 0.5L1 29.586C1 36.214 6.373 41.586 13 41.586H115C121.627 41.586 127 46.959 127 53.586L127 75" stroke="currentColor" stroke-width="1"></path>
						<path d="M1 0.5L1 29.586C1 36.214 6.373 41.586 13 41.586H115C121.627 41.586 127 46.959 127 53.586L127 75" stroke="url(#grad-r2)" stroke-width="1"></path>
						<defs>
							<linearGradient id="grad-r2" x1="0%" y1="0%" x2="0%" y2="0%">
								<animate attributeName="x1" values="0%;100%" dur="4.5s" repeatCount="indefinite" />
								<animate attributeName="y1" values="0%;90%" dur="4.5s" repeatCount="indefinite" />
								<animate attributeName="x2" values="0%;120%" dur="4.5s" repeatCount="indefinite" />
								<animate attributeName="y2" values="0%;120%" dur="4.5s" repeatCount="indefinite" />
								<stop stop-color="#7a0a0a" stop-opacity="0"></stop>
								<stop offset="1" stop-color="#ff5a5a"></stop>
								<stop offset="1" stop-color="#ff5a5a" stop-opacity="0"></stop>
							</linearGradient>
						</defs>
					</svg>
					<svg width="62" height="105" viewBox="0 0 62 105" fill="none" class="absolute -bottom-2 left-1/2 text-neutral-200 dark:text-neutral-800">
						<path d="M1 -69L1 57.5C1 64.127 6.373 69.5 13 69.5H49C55.627 69.5 61 74.873 61 81.5L61 105" stroke="currentColor" stroke-width="1"></path>
						<path d="M1 -69L1 57.5C1 64.127 6.373 69.5 13 69.5H49C55.627 69.5 61 74.873 61 81.5L61 105" stroke="url(#grad-r1)" stroke-width="1"></path>
						<defs>
							<linearGradient id="grad-r1" x1="0%" y1="0%" x2="0%" y2="0%">
								<animate attributeName="x1" values="0%;100%" dur="6.2s" repeatCount="indefinite" />
								<animate attributeName="y1" values="0%;90%" dur="6.2s" repeatCount="indefinite" />
								<animate attributeName="x2" values="0%;120%" dur="6.2s" repeatCount="indefinite" />
								<animate attributeName="y2" values="0%;120%" dur="6.2s" repeatCount="indefinite" />
								<stop stop-color="#7a0a0a" stop-opacity="0"></stop>
								<stop offset="1" stop-color="#ff5a5a"></stop>
								<stop offset="1" stop-color="#ff5a5a" stop-opacity="0"></stop>
							</linearGradient>
						</defs>
					</svg>
					<div class="deploy-grid relative z-30 mx-auto grid w-full max-w-lg grid-cols-1 gap-4 p-8 [perspective:1000px] [transform-style:preserve-3d] sm:p-0 md:grid-cols-3">
						<div class="card-nod relative flex h-14 w-full flex-col items-center justify-center gap-2 rounded-lg bg-gradient-to-b from-white to-white p-2 shadow-lg md:h-40 dark:from-neutral-800 dark:to-neutral-700">
							<svg viewBox="0 0 24 24" class="h-8 w-8 text-neutral-700 dark:text-neutral-300" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="1.5"></rect><rect x="3" y="14" width="18" height="6" rx="1.5"></rect><path d="M7 7h.01M7 17h.01"></path></svg>
							<p class="bg-transparent font-mono text-[8px] text-neutral-500 dark:text-neutral-400">{c.build.infra}</p>
						</div>
						<div class="card-nod relative flex h-14 w-full flex-col items-center justify-center gap-2 rounded-lg bg-gradient-to-b from-white to-white p-2 shadow-lg md:h-40 dark:from-neutral-800 dark:to-neutral-700">
							<img src="/logos/rubot.webp" alt="Rubot" width="80" height="80" loading="lazy" class="rubot-img h-8 w-8 object-contain md:h-20 md:w-20" />
							<p class="bg-transparent font-mono text-[8px] text-neutral-500 dark:text-neutral-400">Rubot</p>
						</div>
						<div class="card-nod relative flex h-14 w-full flex-col items-center justify-center gap-2 rounded-lg bg-gradient-to-b from-white to-white p-2 shadow-lg md:h-40 dark:from-neutral-800 dark:to-neutral-700">
							<svg viewBox="0 0 24 24" class="h-8 w-8 text-brand-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8Z"></path></svg>
							<p class="bg-transparent font-mono text-[8px] text-neutral-500 dark:text-neutral-400">{c.build.automation}</p>
						</div>
					</div>
				</div>
			</div>
			<div class="p-6 md:h-40">
				<h3 class="text-base font-medium tracking-tight text-neutral-700 dark:text-neutral-100">{c.build.agentTitle}</h3>
				<p class="mt-2 max-w-sm text-base font-normal tracking-tight text-neutral-500 dark:text-neutral-400">{c.build.agentText}</p>
			</div>
		</div>

			<div class="feature-card group md:col-span-2" data-reveal>
				<div class="p-6 md:h-40">
					<h3 class="text-base font-medium tracking-tight text-neutral-700 dark:text-neutral-100">{c.build.hostTitle}</h3>
					<p class="mt-2 max-w-xs text-base font-normal tracking-tight text-neutral-500 dark:text-neutral-400">{c.build.hostText}</p>
				</div>
				<div class="relative h-full w-full overflow-hidden">
					<div class="relative h-64 w-full md:h-full">
						<canvas id="edge-globe" class="globe-canvas absolute -right-12 -bottom-40 md:-right-20 md:-bottom-40" aria-hidden="true"></canvas>
					</div>
				</div>
			</div>

			<div class="feature-card group md:col-span-3" data-reveal>
				<div class="p-6">
					<h3 class="text-base font-medium tracking-tight text-neutral-700 dark:text-neutral-100">{c.build.customTitle}</h3>
					<p class="mt-2 max-w-md text-base font-normal tracking-tight text-neutral-500 dark:text-neutral-400">{c.build.customText}</p>
				</div>
				<CustomBuildDevice />
			</div>

			<div class="feature-card relative md:col-span-2 !bg-neutral-950 text-white dark:!bg-neutral-900" data-reveal>
				<div class="grid h-full grid-cols-2">
					{facts.map((f, i) => (
						<div class:list={['flex flex-col justify-end p-6', i % 2 === 0 && 'border-r border-white/10', i < 2 && 'border-b border-white/10']}>
							<Roller value={f.value} class="font-display text-5xl font-bold tracking-tight md:text-6xl" />
							<p class="mt-2 font-mono text-[11px] tracking-wide text-white/60 uppercase">{f.label}</p>
						</div>
					))}
				</div>
				<span class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-500 to-transparent"></span>
			</div>
		</div>
	</div>
</section>

<script>
	// Pause the agent card's looping animations (SVG gradients, card nod)
	// whenever it's off-screen.
	document.querySelectorAll<HTMLElement>('[data-idle]').forEach((card) => {
		const svgs = card.querySelectorAll('svg');
		new IntersectionObserver(([e]) => {
			card.classList.toggle('is-idle', !e.isIntersecting);
			svgs.forEach((s) => (e.isIntersecting ? s.unpauseAnimations() : s.pauseAnimations()));
		}).observe(card);
	});

	// Red globe: cobe is only fetched once the card comes near the viewport.
	const canvas = document.getElementById('edge-globe') as HTMLCanvasElement | null;
	if (canvas) {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let start = () => {};
		let stop = () => {};
		let onScreen = false;
		const boot = async () => {
			const { default: createGlobe } = await import('cobe');
			// Size the backing store from the real CSS box, not a fixed 1200 @2x.
			const cssSize = canvas.clientWidth || 440;
			const globe = createGlobe(canvas, {
				devicePixelRatio: Math.min(window.devicePixelRatio || 1, 2),
				width: cssSize,
				height: cssSize,
				phi: 0,
				theta: -0.2, // tilt so Brazil faces the viewer
				dark: 1,
				diffuse: 1.2,
				mapSamples: 12000,
				mapBrightness: 6,
				baseColor: [0.55, 0.08, 0.08],
				markerColor: [1, 0.3, 0.3],
				glowColor: [1, 0.45, 0.45],
				markerElevation: 0,
				markers: [
					{ location: [-23.5505, -46.6333], size: 0.055 }, // São Paulo
					{ location: [50.1109, 8.6821], size: 0.04 }, // Europe-West (Frankfurt)
					{ location: [38.9072, -77.0369], size: 0.04 }, // US-East (Ashburn)
				],
			});
			let phi = 0;
			let raf = 0;
			const tick = () => {
				phi += 0.008;
				globe.update({ phi });
				raf = requestAnimationFrame(tick);
			};
			start = () => {
				if (!raf && !reduce && !document.hidden && onScreen) raf = requestAnimationFrame(tick);
			};
			stop = () => {
				cancelAnimationFrame(raf);
				raf = 0;
			};
			start();
		};
		let booted = false;
		new IntersectionObserver(
			([e]) => {
				onScreen = e.isIntersecting;
				if (onScreen && !booted) {
					booted = true;
					boot();
				}
				onScreen ? start() : stop();
			},
			{ rootMargin: '200px' },
		).observe(canvas);
		document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
	}
</script>
