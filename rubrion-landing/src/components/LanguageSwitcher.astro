---
// EN <-> PT switcher. Links to the same path on the alternate-locale domain.
// Locale-driven (locale.ts) so the EN and PT trees share this file unchanged.
import { ALT_URL, ALT_LANG_LABEL, ALT_LOCALE } from '../data/locale';

const altHref = `${ALT_URL}${Astro.url.pathname}`;
---

<a
	href={altHref}
	hreflang={ALT_LOCALE}
	aria-label={`Switch language to ${ALT_LANG_LABEL}`}
	class="flex items-center gap-1.5 rounded-xl px-2 py-2 font-mono text-xs font-semibold text-neutral-500 transition hover:text-brand-500"
>
	<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20"></path><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
	{ALT_LANG_LABEL}
</a>
