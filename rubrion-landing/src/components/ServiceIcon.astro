	data: 'M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3Zm0 0v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6',
	seo: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14ZM21 21l-5-5M8 12l2-2 2 2 3-3',
	chatbots: 'M21 12a8 8 0 0 1-11.6 7.1L4 21l1.9-5.4A8 8 0 1 1 21 12ZM8.5 12h.01M12 12h.01M15.5 12h.01',
	publishing: 'M4 5h16v14H4zM4 9h16M8 13h8M8 16h5',
	marketplace: 'M4 9l1.5-5h13L20 9M4 9h16M4 9v10h16V9M9 19v-5h6v5',
