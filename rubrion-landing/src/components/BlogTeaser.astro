---
// Latest posts on the home page, then the newsletter.
import SectionHead from './SectionHead.astro';
import PostCard from './PostCard.astro';
import Newsletter from './Newsletter.astro';
import { c } from '../data/site';
import { getPosts } from '../data/blog';

const posts = (await getPosts()).slice(0, 3);
---

<section id="blog" class="bg-surface px-5 py-28 md:px-8 md:py-40">
	<div class="mx-auto max-w-7xl">
		<div class="flex flex-wrap items-end justify-between gap-6">
			<SectionHead kicker={c.blog.kicker} title={c.blog.title} lead={c.blog.lead} />
			<a href="/blog" class="link-arrow link-arrow--in" data-reveal>{c.blog.all}</a>
		</div>
		<ul class="mt-16 grid grid-cols-1 gap-x-8 gap-y-14 md:grid-cols-3">
			{posts.map((p) => <li data-reveal><PostCard post={p} /></li>)}
		</ul>
		<div class="mt-24"><Newsletter /></div>
	</div>
</section>
