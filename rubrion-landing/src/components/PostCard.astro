---
// Blog post card: cover, category and date, title, excerpt.
import { c } from '../data/site';
import { category, formatDate, type Post } from '../data/blog';

interface Props {
	post: Post;
}
const { post } = Astro.props;
const d = post.data;
---

<a href={`/blog/${post.slug}`} class="group block">
	<div class="aspect-[16/10] overflow-hidden rounded-md bg-surface-2">
		<img src={d.cover.replace('-1600', '-900')} alt="" width="900" height="563" loading="lazy" decoding="async" class="h-full w-full object-cover object-top transition duration-[900ms] group-hover:scale-[1.03]" />
	</div>
	<p class="meta mt-5">{category(d.category)} · <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time> · {d.minutes} {c.blog.read}</p>
	<h3 class="display mt-2 text-[1.4rem]">{d.title}</h3>
	<p class="mt-2 line-clamp-2 text-[0.92rem]/6 text-ink-soft">{d.excerpt}</p>
</a>
