---
// Footer on the dark slab: brand + tagline, pages, partners, socials, then
// the wordmark set large and faint.
import Logo from './Logo.astro';
import { c, email, pages, socials } from '../data/site';
import { credits } from '../data/work';

const year = new Date().getFullYear();
const partners = Object.values(credits).filter((p) => p.url);
const col = 'text-[0.68rem] font-bold tracking-[0.24em] uppercase text-slab-ink/55';
---

<footer class="relative w-full overflow-hidden bg-slab px-5 pt-24 pb-10 text-slab-ink md:px-8">
	<div class="mx-auto grid max-w-7xl gap-12 text-[0.92rem] sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
		<div>
			<Logo class="-ml-1" diagonal={false} />
			<p class="mt-5 max-w-xs text-slab-ink/70">{c.footer.tagline}</p>
			<a href={`mailto:${email}`} class="mt-6 inline-block font-bold hover:text-brand-400">{email}</a>
		</div>
		<nav aria-label={c.footer.pages}>
			<h2 class={col}>{c.footer.pages}</h2>
			<ul class="mt-5 space-y-3 text-slab-ink/80">
				<li><a href="/" class="hover:text-slab-ink">{c.nav.home}</a></li>
				{pages.map((p) => <li><a href={p.href} class="hover:text-slab-ink">{c.nav[p.key]}</a></li>)}
				<li><a href="/brand" class="hover:text-slab-ink">{c.footer.brand}</a></li>
			</ul>
		</nav>
		<div>
			<h2 class={col}>{c.footer.work}</h2>
			<ul class="mt-5 space-y-3 text-slab-ink/80">
				{partners.map((p) => <li><a href={p.url} target="_blank" rel="noopener" class="hover:text-slab-ink">{p.name} ↗</a></li>)}
				<li><a href="https://mondesa.org" target="_blank" rel="noopener" class="hover:text-slab-ink">MonDesa ↗</a></li>
			</ul>
		</div>
		<div>
			<h2 class={col}>{c.footer.follow}</h2>
			<ul class="mt-5 space-y-3 text-slab-ink/80">
				{socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener" class="hover:text-slab-ink">{s.name} ↗</a></li>)}
			</ul>
		</div>
	</div>
	<div class="mx-auto mt-16 flex max-w-7xl flex-wrap justify-between gap-4 border-t border-white/10 pt-6 text-xs text-slab-ink/55">
		<p>© {year} Rubrion. {c.footer.rights}</p>
		<p>{c.tagline}</p>
	</div>
	<p class="footer-word display mt-10 text-center text-[18vw] leading-[0.82] tracking-[-0.04em] uppercase select-none" data-word="Rubrion" aria-hidden="true"></p>
</footer>

<style>
	/* The wordmark under a spotlight: lit from below, fading into the slab
	 * above. Drawn from an attribute, so it's decoration, not text to read. */
	.footer-word::before {
		content: attr(data-word);
		background:
			radial-gradient(ellipse 55% 90% at 50% 105%, rgba(243, 242, 238, 0.34), transparent 70%),
			linear-gradient(180deg, rgba(243, 242, 238, 0) 15%, rgba(243, 242, 238, 0.1));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
</style>
