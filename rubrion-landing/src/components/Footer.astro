---
// Footer: brand + tagline, pages, partners, socials, then the giant gradient
// wordmark watermark.
import Logo from './Logo.astro';
import { c, email, pages, socials } from '../data/site';
import { credits } from '../data/work';

const year = new Date().getFullYear();
const partners = Object.values(credits).filter((p) => p.url);
---

<footer class="relative w-full overflow-hidden border-t border-line bg-white px-4 pt-20 pb-10 md:px-8 dark:border-line-dark dark:bg-neutral-950">
	<span class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-500/70 to-transparent" aria-hidden="true"></span>
	<div class="mx-auto grid max-w-7xl gap-10 text-sm text-neutral-600 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr] dark:text-neutral-400">
		<div>
			<Logo class="-ml-1 text-neutral-900 dark:text-neutral-100" diagonal={false} />
			<p class="mt-4 max-w-xs">{c.footer.tagline}</p>
			<p class="mt-3 font-mono text-xs text-brand-500">{c.tagline}</p>
			<a href={`mailto:${email}`} class="mt-5 inline-block font-medium text-neutral-900 hover:text-brand-500 dark:text-neutral-100">{email}</a>
		</div>
		<nav aria-label={c.footer.pages}>
			<h2 class="font-mono text-[11px] tracking-[0.25em] text-neutral-600 uppercase dark:text-neutral-400">{c.footer.pages}</h2>
			<ul class="mt-4 space-y-2.5">
				<li><a href="/" class="hover:text-brand-500">{c.nav.home}</a></li>
				{pages.map((p) => <li><a href={p.href} class="hover:text-brand-500">{c.nav[p.key]}</a></li>)}
				<li><a href="/brand" class="hover:text-brand-500">{c.footer.brand}</a></li>
			</ul>
		</nav>
		<div>
			<h2 class="font-mono text-[11px] tracking-[0.25em] text-neutral-600 uppercase dark:text-neutral-400">{c.footer.work}</h2>
			<ul class="mt-4 space-y-2.5">
				{partners.map((p) => <li><a href={p.url} target="_blank" rel="noopener" class="hover:text-brand-500">{p.name} ↗</a></li>)}
				<li><a href="https://mondesa.org" target="_blank" rel="noopener" class="hover:text-brand-500">MonDesa ↗</a></li>
			</ul>
		</div>
		<div>
			<h2 class="font-mono text-[11px] tracking-[0.25em] text-neutral-600 uppercase dark:text-neutral-400">{c.footer.follow}</h2>
			<ul class="mt-4 space-y-2.5">
				{socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener" class="hover:text-brand-500">{s.name} ↗</a></li>)}
			</ul>
		</div>
	</div>
	<p class="mx-auto mt-14 max-w-7xl text-xs text-neutral-600 dark:text-neutral-400">© {year} Rubrion. {c.footer.rights}</p>
	<p class="mt-8 bg-gradient-to-b from-neutral-50 to-neutral-200 bg-clip-text text-center font-display text-5xl font-bold text-transparent uppercase select-none md:text-9xl lg:text-[12rem] xl:text-[13rem] dark:from-neutral-950 dark:to-neutral-800" aria-hidden="true">
		Rubrion
	</p>
</footer>
