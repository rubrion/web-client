---
// Start a project: the closing dark slab, with the ambient shader behind a
// short brief form (Turnstile-protected, posts to the support-email-worker).
import { c, email, whatsapp } from '../data/site';

const t = c.contact;
const label = 'text-[0.7rem] font-bold tracking-[0.2em] uppercase text-slab-ink/60';
---

<section id="contact" class="on-slab relative w-full overflow-hidden bg-slab px-5 py-28 text-slab-ink md:px-8 md:py-40">
	<canvas class="absolute inset-0 h-full w-full" data-ambient="slab" aria-hidden="true"></canvas>
	<div class="relative z-10 mx-auto grid max-w-7xl gap-16 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-24">
		<div>
			<p class="eyebrow !text-slab-ink/70" data-reveal>{t.kicker}</p>
			<h2 class="display mt-6 text-[2.4rem] md:text-[4rem]" data-split set:html={t.title} />
			<p class="mt-6 max-w-md text-[1.02rem]/8 text-slab-ink/70" data-reveal>{t.lead}</p>
			<dl class="mt-12 grid max-w-md gap-6 border-t border-white/10 pt-8 text-[0.95rem]" data-reveal>
				<div class="flex justify-between gap-6"><dt class="text-slab-ink/55">{t.emailLabel}</dt><dd><a href={`mailto:${email}`} class="font-bold hover:text-brand-400">{email}</a></dd></div>
				<div class="flex justify-between gap-6"><dt class="text-slab-ink/55">WhatsApp</dt><dd><a href={whatsapp} target="_blank" rel="noopener" class="font-bold hover:text-brand-400">+55 11 99256-2478</a></dd></div>
				<div class="flex justify-between gap-6"><dt class="text-slab-ink/55">{t.responseLabel}</dt><dd>{t.response}</dd></div>
				<div class="flex justify-between gap-6"><dt class="text-slab-ink/55">{t.deployLabel}</dt><dd>{t.deploy}</dd></div>
			</dl>
		</div>

		<div class="contact-box relative" data-reveal data-contact-box>
			<form id="contact-form" class="contact-form space-y-8" data-strings={JSON.stringify(t)} >
				<div class="grid gap-8 sm:grid-cols-2">
					<div>
						<label for="contact-name" class={label}>{t.name} *</label>
						<input type="text" id="contact-name" name="name" required autocomplete="name" class="input" />
					</div>
					<div>
						<label for="contact-email" class={label}>{t.email} *</label>
						<input type="email" id="contact-email" name="email" required autocomplete="email" class="input" />
					</div>
				</div>
				<div>
					<label for="contact-company" class={label}>{t.company}</label>
					<input type="text" id="contact-company" name="company" autocomplete="organization" class="input" />
				</div>
				<div>
					<label for="contact-message" class={label}>{t.message} *</label>
					<textarea id="contact-message" name="message" required rows="4" class="input resize-none"></textarea>
				</div>

				{/* Honeypot: bots fill it, humans never see it */}
				<div aria-hidden="true" style="position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden;">
					<label for="contact-website">Website</label>
					<input type="text" id="contact-website" name="honeypot" tabindex="-1" autocomplete="off" />
				</div>

				<div id="contact-turnstile"></div>

				<p id="contact-error" class="hidden border-l border-brand-500 pl-3 text-sm text-brand-400">
					{t.error}: <span id="contact-error-text"></span>
				</p>

				<button id="contact-submit" type="submit" class="btn btn--light disabled:cursor-not-allowed disabled:opacity-50"><span class="form-spinner" aria-hidden="true"></span><span data-label>{t.send}</span></button>
			</form>

			<div id="contact-success" class="contact-sent" role="status" aria-live="polite">
				<svg class="sent-check" viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="24"></circle><path d="M15 27l7 7 15-16"></path></svg>
				<p class="eyebrow mt-8 !text-slab-ink/70">{t.sent}</p>
				<p class="display mt-4 text-3xl">{t.sentNote}</p>
				<button type="button" class="link-arrow link-arrow--in mt-8 !text-slab-ink" data-contact-again>{t.another}</button>
			</div>
		</div>
	</div>
</section>

<script>
	const WORKER_URL = import.meta.env.VITE_SUPPORT_WORKER_URL as string | undefined;
	const TURNSTILE_SITE_KEY = import.meta.env.VITE_TURNSTILE_SITE_KEY as string | undefined;

	declare global {
		interface Window {
			turnstile?: {
				render: (
					container: HTMLElement | string,
					options: {
						sitekey: string;
						callback?: (token: string) => void;
						'expired-callback'?: () => void;
						'error-callback'?: () => void;
						theme?: 'light' | 'dark' | 'auto';
						size?: 'normal' | 'compact' | 'flexible';
					}
				) => string;
				reset: (widgetId?: string) => void;
				remove: (widgetId?: string) => void;
			};
		}
	}

	const t = JSON.parse(document.getElementById('contact-form')?.dataset.strings ?? '{}') as Record<string, string>;
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
	const errorBox = document.getElementById('contact-error');
	const errorText = document.getElementById('contact-error-text');
	const successBox = document.getElementById('contact-success');
	const box = document.querySelector<HTMLElement>('[data-contact-box]');
	successBox?.querySelector('[data-contact-again]')?.addEventListener('click', () => {
		box?.classList.remove('is-sent');
		(document.getElementById('contact-name') as HTMLInputElement | null)?.focus({ preventScroll: true });
	});
	const turnstileContainer = document.getElementById('contact-turnstile');

	const captchaRequired = Boolean(TURNSTILE_SITE_KEY);
	let turnstileToken: string | null = null;
	let widgetId: string | null = null;

	const updateSubmitState = (submitting = false) => {
		if (!submitBtn) return;
		submitBtn.disabled = submitting || (captchaRequired && !turnstileToken);
		submitBtn.classList.toggle('is-busy', submitting);
		submitBtn.querySelector('[data-label]')!.textContent = submitting ? t.sending : captchaRequired && !turnstileToken ? t.verifying : t.send;
	};

	const renderTurnstile = () => {
		if (!captchaRequired || !turnstileContainer || !window.turnstile) return;
		if (widgetId) return;
		widgetId = window.turnstile.render(turnstileContainer, {
			sitekey: TURNSTILE_SITE_KEY!,
			theme: 'dark',
			size: 'flexible',
			callback: (token: string) => {
				turnstileToken = token;
				updateSubmitState();
			},
			'expired-callback': () => {
				turnstileToken = null;
				updateSubmitState();
			},
			'error-callback': () => {
				turnstileToken = null;
				updateSubmitState();
			},
		});
	};

	const resetCaptcha = () => {
		turnstileToken = null;
		if (widgetId && window.turnstile) {
			try {
				window.turnstile.reset(widgetId);
			} catch {
				widgetId = null;
				renderTurnstile();
			}
		}
		updateSubmitState();
	};

	if (captchaRequired) {
		updateSubmitState();
		// Layout.astro loads Turnstile once the form is near the viewport.
		if (window.turnstile) renderTurnstile();
		else addEventListener('turnstile:ready', renderTurnstile, { once: true });
	}

	const showError = (message: string) => {
		if (errorBox && errorText) {
			errorText.textContent = message;
			errorBox.classList.remove('hidden');
		}
	};

	const hideError = () => errorBox?.classList.add('hidden');

	form?.addEventListener('input', hideError);

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		hideError();

		const fd = new FormData(form);
		const name = String(fd.get('name') ?? '').trim();
		const email = String(fd.get('email') ?? '').trim();
		const company = String(fd.get('company') ?? '').trim();
		const message = String(fd.get('message') ?? '').trim();
		const honeypot = String(fd.get('honeypot') ?? '');

		if (!name || !email || !message) {
			showError(t.required);
			return;
		}
		if (!WORKER_URL) {
			showError(t.noEndpoint);
			return;
		}
		if (captchaRequired && !turnstileToken) {
			showError(t.captcha);
			return;
		}

		updateSubmitState(true);

		const payload = {
			name,
			email,
			subject: t.subject,
			message: company ? `${t.companyLabel}: ${company}\n\n${message}` : message,
			turnstileToken: turnstileToken ?? '',
			honeypot,
		};

		try {
			const response = await fetch(WORKER_URL, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload),
			});

			if (!response.ok) {
				let msg = t.failed;
				try {
					const data = (await response.json()) as { error?: string };
					if (data?.error) msg = data.error;
				} catch {
					/* keep default */
				}
				showError(msg);
				resetCaptcha();
				return;
			}

			// The form steps back and the confirmation draws in over it; it stays
			// until the visitor asks to write again.
			box?.classList.add('is-sent');
			form.reset();
			resetCaptcha();
			(successBox?.querySelector('[data-contact-again]') as HTMLElement | null)?.focus({ preventScroll: true });
		} catch (submitError) {
			console.error('Failed to send message:', submitError);
			showError(t.network);
			resetCaptcha();
		} finally {
			updateSubmitState(false);
		}
	});
</script>

<style>
	/* Sent: the form fades back and lifts away, the confirmation rises in
	   with its check drawing itself. */
	.contact-form {
		transition:
			opacity 0.5s ease,
			transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
			filter 0.5s ease,
			visibility 0s linear 0s;
	}

	.contact-box.is-sent .contact-form {
		opacity: 0;
		transform: translateY(-14px) scale(0.98);
		filter: blur(6px);
		visibility: hidden;
		pointer-events: none;
		transition-delay: 0s, 0s, 0s, 0.6s;
	}

	.contact-sent {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		opacity: 0;
		transform: translateY(16px);
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 0.5s ease,
			transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s linear 0.7s;
	}

	.contact-box.is-sent .contact-sent {
		opacity: 1;
		transform: none;
		visibility: visible;
		pointer-events: auto;
		transition-delay: 0.25s, 0.25s, 0s;
	}

	.sent-check {
		width: 3.5rem;
		height: 3.5rem;
		fill: none;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.sent-check circle {
		stroke: rgba(255, 255, 255, 0.18);
	}

	.sent-check path {
		stroke: var(--color-brand-400);
		stroke-dasharray: 40;
		stroke-dashoffset: 40;
	}

	.contact-box.is-sent .sent-check path {
		transition: stroke-dashoffset 0.6s cubic-bezier(0.65, 0, 0.35, 1) 0.65s;
		stroke-dashoffset: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-form,
		.contact-sent,
		.contact-box.is-sent .sent-check path {
			transition: none;
		}
	}
</style>
