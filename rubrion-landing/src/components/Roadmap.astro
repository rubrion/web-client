---
// Our story: a short founder bio and a horizontal roadmap from Samuel's
// developer years (2021) through the founding (10 Oct 2024) to today, then two goals 3 and 5 years out. Past points are
// solid and joined by a red line; future ones are hollow on a dashed line.
// Stacks vertically on phones.
import { l } from '../data/locale';

const steps = l({
	en: [
		{ when: '2021', title: 'Software developer', text: 'Samuel starts working as a software developer, and later takes freelance projects on the side to complement his income.' },
		{ when: '10 Oct 2024', title: 'Founded', text: 'The freelance work becomes Rubrion, registered as an MEI.' },
		{ when: 'Consulting', title: 'Bigger projects', text: 'Consulting work through MT2 Data and Sennatech brings larger systems and a steady pipeline.' },
		{ when: 'Today', title: 'Teams and many projects', text: 'We work in teams and run several client projects and our own products side by side.' },
		{ when: '2029 · in 3 years', title: 'An in-house team', text: 'Grow the team and hire our own professionals to staff consulting projects.', next: true },
		{ when: '2031 · in 5 years', title: 'Our own products, at scale', text: 'Invest in innovative products of our own, built to sell at scale.', next: true },
	],
	pt: [
		{ when: '2021', title: 'Desenvolvedor de software', text: 'Samuel começa a trabalhar como desenvolvedor de software e, depois, passa a pegar projetos freelance em paralelo para complementar a renda.' },
		{ when: '10 out. 2024', title: 'Fundação', text: 'O trabalho freelance vira a Rubrion, registrada como MEI.' },
		{ when: 'Consultoria', title: 'Projetos maiores', text: 'Consultorias com a MT2 Data e a Sennatech trazem sistemas maiores e demanda constante.' },
		{ when: 'Hoje', title: 'Equipes e vários projetos', text: 'Trabalhamos em equipes e tocamos vários projetos de clientes e produtos próprios ao mesmo tempo.' },
		{ when: '2029 · em 3 anos', title: 'Equipe própria', text: 'Crescer o time e contratar profissionais próprios para os projetos de consultoria.', next: true },
		{ when: '2031 · em 5 anos', title: 'Produtos próprios, em escala', text: 'Investir em produtos inovadores nossos, feitos para vender em escala.', next: true },
	],
});
const t = l({
	en: {
		kicker: 'Our story',
		role: 'Founder',
		site: 'https://rubenszinho.dev',
		siteLabel: 'Personal website',
		bio: 'Samuel has worked as a software developer since 2021 and began freelancing alongside his job to complement his income. On 10 October 2024 that work became Rubrion, registered as an MEI (Brazil’s micro-entrepreneur status); since 2026 it is a limited company, Rubrion Tech Ltda. Consulting projects grew it into a studio that now works in teams across several projects at once.',
	},
	pt: {
		kicker: 'Nossa história',
		role: 'Fundador',
		site: 'https://samuelrubens.com',
		siteLabel: 'Site pessoal',
		bio: 'Samuel trabalha como desenvolvedor de software desde 2021 e começou a fazer freelas em paralelo ao emprego para complementar a renda. Em 10 de outubro de 2024 esse trabalho virou a Rubrion, registrada como MEI; desde 2026 é uma sociedade limitada, a Rubrion Tech Ltda. Os projetos de consultoria a transformaram num estúdio que hoje trabalha em equipes, em vários projetos ao mesmo tempo.',
	},
});
---

<div class="mt-24 md:mt-32">
	<div class="grid gap-8 border-t border-hair pt-10 md:grid-cols-[minmax(0,22rem)_1fr] md:gap-16" data-reveal>
		<div class="flex items-center gap-4">
			<img src="/images/founder.webp" alt="Samuel Rubens Souza Oliveira" width="240" height="240" loading="lazy" decoding="async" class="h-20 w-20 rounded-full object-cover ring-1 ring-hair" />
			<div>
				<p class="eyebrow">{t.kicker}</p>
				<p class="display mt-2 text-[1.2rem] leading-tight">Samuel Rubens Souza Oliveira</p>
				<p class="meta mt-1">{t.role}</p>
				<div class="mt-2 flex gap-3 text-ink-soft">
					<a href={t.site} target="_blank" rel="noopener" aria-label={t.siteLabel} title={t.siteLabel} class="transition-colors hover:text-ink">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9s1.3-6.3 3.8-9z" /></svg>
					</a>
					<a href="https://github.com/rubenszinho" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub" class="transition-colors hover:text-ink">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z" /></svg>
					</a>
				</div>
			</div>
		</div>
		<p class="lead max-w-2xl">{t.bio}</p>
	</div>

	<ol class="roadmap mt-14">
		{steps.map((s) => (
			<li class:list={['roadmap__step', s.next && 'is-next']} data-reveal>
				<span class="roadmap__dot" aria-hidden="true"></span>
				<p class="meta">{s.when}</p>
				<h3 class="display mt-2 text-[1.2rem]">{s.title}</h3>
				<p class="mt-2 text-[0.9rem]/6 text-ink-soft">{s.text}</p>
			</li>
		))}
	</ol>
</div>

<style>
	.roadmap {
		display: grid;
		gap: 2.25rem;
	}

	.roadmap__step {
		position: relative;
		padding-left: 2rem;
	}

	/* The line: solid red through the past, dashed hairline into the future. */
	.roadmap__step::before {
		content: '';
		position: absolute;
		left: 0.36rem;
		top: 0.5rem;
		bottom: -2.25rem;
		border-left: 1px solid var(--color-brand-500);
	}

	.roadmap__step:last-child::before {
		display: none;
	}

	.roadmap__step.is-next::before,
	.roadmap__step:has(+ .is-next)::before {
		border-left: 1px dashed var(--ink-faint);
	}

	.roadmap__dot {
		position: absolute;
		left: 0;
		top: 0.2rem;
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
		background: var(--color-brand-500);
		box-shadow: 0 0 0 4px var(--paper);
	}

	.is-next .roadmap__dot {
		border: 1px solid var(--ink-faint);
		background: var(--paper);
	}

	@media (min-width: 768px) {
		.roadmap {
			grid-template-columns: repeat(6, minmax(0, 1fr));
			gap: 1.5rem;
		}

		.roadmap__step {
			padding-left: 0;
			padding-top: 2rem;
		}

		.roadmap__step::before {
			left: 0.5rem;
			right: -1.5rem;
			top: 0.36rem;
			bottom: auto;
			border-left: 0;
			border-top: 1px solid var(--color-brand-500);
		}

		.roadmap__step.is-next::before,
		.roadmap__step:has(+ .is-next)::before {
			border-left: 0;
			border-top: 1px dashed var(--ink-faint);
		}

		.roadmap__dot {
			top: 0;
		}
	}
</style>
