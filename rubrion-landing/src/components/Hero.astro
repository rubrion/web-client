---
// Home hero: the portfolio, full screen. Two projects at once, split by a
// diagonal hairline seam; every few seconds the next pair dissolves in from
// the seam outward through a soft distortion (scripts/hero-gl.ts).
//
// The first pair is plain <img> (fast first paint, and the fallback without
// WebGL); the canvas takes over once its textures are decoded. It only draws
// during a change, never at rest. Autoplay runs continuously, pausing only
// off-screen, in a hidden tab, or with the pause button.
import { l } from '../data/locale';
import { c } from '../data/site';
import { credits, heroWork } from '../data/work';

const slides = heroWork.map((w) => ({
	slug: w.slug,
	name: l(w.name),
	kind: l(w.kind),
	credit: credits[w.credit].name,
	src: `/work/${w.image}-1600.webp`,
	small: `/work/${w.image}-900.webp`,
}));
const pairs = Math.ceil(slides.length / 2);
const at = (i: number) => slides[i % slides.length];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section data-hero class="dhero relative h-[100svh] min-h-[38rem] overflow-hidden bg-[#141413] text-white" aria-roledescription="carousel" aria-label={c.work.kicker} data-slides={JSON.stringify(slides)}>
	{[0, 1].map((slot) => (
		<div class:list={['dhero__slot', slot === 0 ? 'dhero__slot--top' : 'dhero__slot--bottom']}>
			<img
				class="dhero__img"
				data-fallback={slot}
				src={at(slot).src}
				srcset={`${at(slot).small} 900w, ${at(slot).src} 1600w`}
				sizes="100vw"
				alt=""
				width="1600"
				height="900"
				loading="eager"
				fetchpriority={slot === 0 ? 'high' : 'auto'}
				decoding="async"
			/>
			<span class="dhero__shade" aria-hidden="true"></span>
		</div>
	))}
	<svg class="dhero__seam dhero__seam--wide" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><line x1="0" y1="78" x2="100" y2="38" /></svg>
	<svg class="dhero__seam dhero__seam--narrow" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><line x1="0" y1="72" x2="100" y2="56" /></svg>
	<canvas class="dhero__gl" data-hero-gl aria-hidden="true"></canvas>

	<div class="dhero__copy">
		<p class="eyebrow !text-white/75">{c.hero.kicker}</p>
		<h1 class="display mt-5 text-[2.6rem] sm:text-6xl lg:text-[5.2rem]" set:html={c.hero.title} />
		<p class="mt-6 max-w-md text-base/7 text-white/75 md:text-[1.05rem]/8">{c.hero.lead}</p>
		<div class="mt-9 flex flex-wrap gap-3">
			<a href="#contact" class="btn btn--light">{c.hero.cta}</a>
			<a href="/work" data-diagonal class="btn btn--ghost-light">{c.hero.secondary}</a>
		</div>
	</div>

	{[0, 1].map((slot) => (
		<a href={`/work/${at(slot).slug}`} data-cap={slot} class:list={['dhero__cap', slot === 0 ? 'dhero__cap--top' : 'dhero__cap--bottom']}>
			<span class="dhero__meta"><span data-cap-credit>{at(slot).credit}</span> · <span data-cap-kind>{at(slot).kind}</span></span>
			<span class="dhero__name" data-cap-name>{at(slot).name}</span>
			<span class="visually-hidden">{c.hero.viewCase}</span>
		</a>
	))}

	<div class="dhero__controls">
		<span class="dhero__count" data-count>{pad(1)}</span>
		<span class="dhero__track" aria-hidden="true"><span class="dhero__fill" data-fill></span></span>
		<span class="dhero__count opacity-60">{pad(pairs)}</span>
		<span class="dhero__sep" aria-hidden="true"></span>
		<button type="button" class="dhero__btn" data-prev aria-label={c.hero.prev}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5"></path></svg></button>
		<button type="button" class="dhero__btn" data-next aria-label={c.hero.next}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5"></path></svg></button>
		<button type="button" class="dhero__btn" data-pause aria-label={c.hero.pause} aria-pressed="false" data-pause-label={c.hero.pause} data-play-label={c.hero.play}>
			<svg viewBox="0 0 16 16" aria-hidden="true" data-icon-pause><path d="M6 3.5v9M10 3.5v9"></path></svg>
			<svg viewBox="0 0 16 16" aria-hidden="true" data-icon-play class="hidden"><path d="M5.5 3.5 12 8l-6.5 4.5Z"></path></svg>
		</button>
	</div>
	<p class="visually-hidden" aria-live="polite" data-announce></p>
</section>

<script>
	import { createHeroGL } from '../scripts/hero-gl';

	type Slide = { slug: string; name: string; kind: string; credit: string; src: string; small: string };

	const hero = document.querySelector<HTMLElement>('[data-hero]');
	if (hero) {
		const slides: Slide[] = JSON.parse(hero.dataset.slides!);
		const pairs = Math.ceil(slides.length / 2);
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const narrow = () => innerWidth < 768;
		const caps = [...hero.querySelectorAll<HTMLAnchorElement>('[data-cap]')];
		const fallbacks = [...hero.querySelectorAll<HTMLImageElement>('[data-fallback]')];
		const fill = hero.querySelector<HTMLElement>('[data-fill]')!;
		const count = hero.querySelector<HTMLElement>('[data-count]')!;
		const pauseBtn = hero.querySelector<HTMLButtonElement>('[data-pause]')!;
		const announce = hero.querySelector<HTMLElement>('[data-announce]')!;
		const canvas = hero.querySelector<HTMLCanvasElement>('[data-hero-gl]')!;
		const at = (i: number) => slides[((i % slides.length) + slides.length) % slides.length];
		const pairOf = (p: number) => [at(p * 2), at(p * 2 + 1)] as [Slide, Slide];

		// Created on idle after load (below): context creation and shader
		// compilation stay off the critical path.
		let gl: ReturnType<typeof createHeroGL> = null;
		let pair = 0;
		let busy = false;

		const caption = (slot: number, s: Slide) => {
			const cap = caps[slot];
			cap.href = `/work/${s.slug}`;
			cap.querySelector('[data-cap-credit]')!.textContent = s.credit;
			cap.querySelector('[data-cap-kind]')!.textContent = s.kind;
			cap.querySelector('[data-cap-name]')!.textContent = s.name;
		};

		/** Run `step(k)` for k 0 to 1 over `ms`, eased; resolves at the end. */
		const tween = (ms: number, step: (k: number) => void) =>
			new Promise<void>((done) => {
				const t0 = performance.now();
				const frame = (now: number) => {
					const k = Math.min(1, (now - t0) / ms);
					step(k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2);
					if (k < 1) requestAnimationFrame(frame);
					else done();
				};
				requestAnimationFrame(frame);
			});

		const show = async (next: number) => {
			if (busy) return;
			next = ((next % pairs) + pairs) % pairs;
			if (next === pair) return;
			busy = true;
			const incoming = pairOf(next);
			caps.forEach((cap) => cap.classList.add('is-changing'));
			const r = hero.classList.contains('is-gl') ? gl : null;
			if (r) {
				// Decode before the seam opens, so it never opens onto a gap.
				await r.load(incoming);
				if (reduced) r.setProgress(1);
				else await tween(1500, (k) => { r.setProgress(k); r.draw(performance.now() / 1000); });
				r.commit();
				r.draw(performance.now() / 1000);
			} else {
				// No (hardware) WebGL: fade the halves out, swap once decoded, fade in.
				const pre = incoming.map((s) => {
					const img = new Image();
					img.src = innerWidth < 1000 ? s.small : s.src;
					return img.decode().then(() => img.src).catch(() => img.src);
				});
				hero.classList.add('is-swapping');
				const [srcs] = await Promise.all([Promise.all(pre), new Promise((r) => setTimeout(r, reduced ? 0 : 450))]);
				fallbacks.forEach((img, i) => {
					img.srcset = '';
					img.src = srcs[i];
				});
				hero.classList.remove('is-swapping');
			}
			incoming.forEach((s, i) => caption(i, s));
			caps.forEach((cap) => cap.classList.remove('is-changing'));
			pair = next;
			count.textContent = String(pair + 1).padStart(2, '0');
			announce.textContent = `${incoming[0].name} · ${incoming[1].name}`;
			gl?.preload(pairOf(pair + 1));
			busy = false;
		};

		// Autoplay: continuous. Stops only off-screen, in a hidden tab, or paused.
		const DELAY = 6500;
		let timer = 0;
		let visible = true;
		let paused = false;
		const restartFill = (running: boolean) => {
			fill.style.transition = 'none';
			fill.style.transform = 'scaleX(0)';
			void fill.offsetWidth;
			if (running) {
				fill.style.transition = `transform ${DELAY}ms linear`;
				fill.style.transform = 'scaleX(1)';
			}
		};
		const stop = () => {
			clearTimeout(timer);
			timer = 0;
			restartFill(false);
		};
		const play = () => {
			stop();
			if (!visible || paused || document.hidden) return;
			restartFill(true);
			timer = window.setTimeout(() => show(pair + 1).then(play), DELAY);
		};
		const go = (p: number) => {
			stop();
			show(p).then(play);
		};

		hero.querySelector('[data-prev]')!.addEventListener('click', () => go(pair - 1));
		hero.querySelector('[data-next]')!.addEventListener('click', () => go(pair + 1));
		pauseBtn.addEventListener('click', () => {
			paused = !paused;
			pauseBtn.setAttribute('aria-pressed', String(paused));
			pauseBtn.setAttribute('aria-label', paused ? pauseBtn.dataset.playLabel! : pauseBtn.dataset.pauseLabel!);
			pauseBtn.querySelector('[data-icon-pause]')!.classList.toggle('hidden', paused);
			pauseBtn.querySelector('[data-icon-play]')!.classList.toggle('hidden', !paused);
			paused ? stop() : play();
		});
		hero.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') go(pair + 1);
			if (e.key === 'ArrowLeft') go(pair - 1);
		});

		// Swipe: a mostly horizontal drag of 50px turns the pair.
		let sx = 0;
		let sy = 0;
		hero.addEventListener('pointerdown', (e) => { sx = e.clientX; sy = e.clientY; }, { passive: true });
		hero.addEventListener('pointerup', (e) => {
			const dx = e.clientX - sx;
			if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(e.clientY - sy) * 1.5) go(pair + (dx < 0 ? 1 : -1));
		}, { passive: true });

		new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			visible ? play() : stop();
		}, { threshold: 0.2 }).observe(hero);
		document.addEventListener('visibilitychange', () => (document.hidden ? stop() : play()));

		// WebGL takes over once the first pair is decoded, when the browser is
		// idle after load, so it never competes with the first paint.
		const start = () => {
			gl = createHeroGL(canvas, narrow);
			if (!gl) return;
			const renderer = gl;
			renderer
				.set(pairOf(pair))
				.then(() => {
					renderer.setIntro(1);
					renderer.draw(0);
					hero.classList.add('is-gl');
					renderer.preload(pairOf(pair + 1));
					new ResizeObserver(() => renderer.draw(performance.now() / 1000)).observe(canvas);
				})
				.catch(() => {
					gl = null;
				});
		};
		addEventListener(
			'load',
			() => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2500 }) : setTimeout(start, 400)),
			{ once: true },
		);
		play();
	}
</script>

<style>
	/* Fallback (no WebGL yet, or none at all): the same seam with CSS clips. */
	.dhero {
		--a: 78%;
		--b: 38%;
	}

	.dhero__slot {
		position: absolute;
		inset: 0;
		transition: opacity 0.6s ease;
	}

	.dhero__slot--top {
		clip-path: polygon(0 0, 100% 0, 100% var(--b), 0 var(--a));
	}

	.dhero__slot--bottom {
		clip-path: polygon(0 var(--a), 100% var(--b), 100% 100%, 0 100%);
	}

	.dhero__img {
		position: absolute;
		left: 0;
		width: 100%;
		object-fit: cover;
		object-position: center top;
	}

	.dhero__slot--top .dhero__img {
		top: 0;
		height: var(--a);
	}

	.dhero__slot--bottom .dhero__img {
		top: var(--b);
		height: calc(100% - var(--b));
	}

	.dhero__shade {
		position: absolute;
		inset: 0;
	}

	.dhero__slot--top .dhero__shade {
		background:
			linear-gradient(90deg, rgba(0, 0, 0, 0.88), rgba(0, 0, 0, 0.7) 45%, rgba(0, 0, 0, 0.25) 85%),
			linear-gradient(180deg, rgba(0, 0, 0, 0.45), transparent 22%);
	}

	.dhero__slot--bottom .dhero__shade {
		background: linear-gradient(0deg, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.15) 50%);
	}

	.dhero__gl {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		transition: opacity 0.5s ease;
	}

	.dhero.is-gl .dhero__gl {
		opacity: 1;
	}

	.dhero.is-gl .dhero__slot,
	.dhero.is-swapping .dhero__slot {
		opacity: 0;
	}

	/* CSS-drawn seam for the fallback; the shader draws its own. */
	.dhero__seam {
		position: absolute;
		inset: 0;
		z-index: 3;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.dhero__seam line {
		stroke: var(--color-brand-500);
		stroke-width: 1.5px;
		vector-effect: non-scaling-stroke;
	}

	.dhero.is-gl .dhero__seam {
		display: none;
	}

	.dhero__seam--narrow {
		display: none;
	}

	.dhero__copy {
		position: absolute;
		z-index: 4;
		left: max(1.25rem, calc((100vw - 80rem) / 2 + 2rem));
		top: clamp(6.5rem, 21vh, 12rem);
		max-width: min(42rem, calc(100vw - 2.5rem));
	}

	:global(.has-motion) .dhero__copy > * {
		opacity: 0;
		transform: translateY(14px);
		animation: dhero-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}

	.dhero__copy > :nth-child(2) {
		animation-delay: 0.08s;
	}
	.dhero__copy > :nth-child(3) {
		animation-delay: 0.18s;
	}
	.dhero__copy > :nth-child(4) {
		animation-delay: 0.28s;
	}

	@keyframes dhero-in {
		to {
			opacity: 1;
			transform: none;
		}
	}

	/* Captions: no boxes, just type on the image. */
	.dhero__cap {
		position: absolute;
		z-index: 4;
		display: grid;
		gap: 0.3rem;
		max-width: min(22rem, calc(100vw - 2.5rem));
		padding-left: 0.9rem;
		border-left: 1px solid rgba(255, 255, 255, 0.4);
		text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
		transition:
			opacity 0.45s ease,
			border-color 0.3s ease;
	}

	.dhero__cap:hover {
		border-color: var(--color-brand-500);
	}

	.dhero__cap.is-changing {
		opacity: 0;
	}

	.dhero__meta {
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.7);
	}

	.dhero__name {
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.dhero__name::after {
		content: ' ↗';
		font-size: 0.8em;
		opacity: 0.7;
	}

	.dhero__cap--top {
		right: max(1.25rem, calc((100vw - 80rem) / 2 + 2rem));
		top: calc(var(--b) - 6rem);
	}

	/* Clear of the chat pill in the corner. */
	.dhero__cap--bottom {
		right: max(1.25rem, calc((100vw - 80rem) / 2 + 2rem));
		bottom: 6rem;
	}

	/* Slim controls: counter, hairline progress, three small glyph buttons. */
	.dhero__controls {
		position: absolute;
		z-index: 4;
		left: max(1.25rem, calc((100vw - 80rem) / 2 + 2rem));
		bottom: 2.3rem;
		display: flex;
		align-items: center;
		gap: 0.85rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.dhero__track {
		position: relative;
		width: 5.5rem;
		height: 1px;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.28);
	}

	.dhero__fill {
		position: absolute;
		inset: 0;
		background: #fff;
		transform: scaleX(0);
		transform-origin: left;
	}

	.dhero__sep {
		width: 1px;
		height: 0.9rem;
		margin-inline: 0.2rem;
		background: rgba(255, 255, 255, 0.25);
	}

	.dhero__btn {
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		color: rgba(255, 255, 255, 0.75);
		cursor: pointer;
		transition: color 0.2s;
	}

	.dhero__btn:hover {
		color: #fff;
	}

	.dhero__btn svg {
		width: 0.9rem;
		height: 0.9rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.dhero__btn [data-icon-play] {
		fill: currentColor;
		stroke: none;
	}

	@media (max-width: 767px) {
		.dhero {
			--a: 72%;
			--b: 56%;
		}

		.dhero__copy {
			top: 5.75rem;
		}

		.dhero__seam--wide {
			display: none;
		}

		.dhero:not(.is-gl) .dhero__seam--narrow {
			display: block;
		}

		.dhero__slot--top .dhero__shade {
			background: rgba(0, 0, 0, 0.6);
		}

		.dhero__cap {
			left: 1.25rem;
			right: auto;
		}

		.dhero__cap--top {
			top: auto;
			bottom: 9rem;
		}

		.dhero__cap--bottom {
			bottom: 5rem;
		}

		.dhero__controls {
			bottom: 1.6rem;
		}
	}

	@media (max-height: 640px) and (max-width: 767px) {
		.dhero__cap--top {
			display: none;
		}
	}
</style>
