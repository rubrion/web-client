---
// Chat: a scripted assistant (scripts/chat.ts). No AI and no running cost;
// the menu covers what we build, cost, budget, timing and work, and hands
// anything else to a person on WhatsApp or email. `[data-chat-open]` buttons
// anywhere on the page open it.
import { c, email, whatsapp } from '../data/site';
import { work } from '../data/work';
import Rubry from './Rubry.astro';

const t = c.chat;
const data = {
	s: { hello: t.hello, options: t.options, answers: t.answers },
	services: Object.values(c.services.items).map(([name]) => name),
	count: work.length,
	whatsapp,
	email,
};
---

<div class="chat" data-chat>
	<section class="chat__panel" id="chat-panel" role="dialog" aria-label={t.open} data-chat-panel hidden>
		<header class="chat__head">
			<span class="chat__mark" aria-hidden="true"><Rubry /></span>
			<div class="min-w-0">
				<p class="chat__title">{t.title}</p>
				<p class="chat__status"><span aria-hidden="true"></span>{t.status}</p>
			</div>
			<button class="chat__icon" type="button" data-chat-restart title={t.restart}>
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8a5 5 0 1 0 1.5-3.6M3 2.5v2.4h2.4"></path></svg>
				<span class="visually-hidden">{t.restart}</span>
			</button>
		</header>
		<ol class="chat__log" aria-live="polite" data-chat-log data-lenis-prevent></ol>
		<div class="chat__options" role="group" data-chat-options></div>
	</section>
	<button class="chat__launcher" type="button" aria-controls="chat-panel" aria-expanded="false" data-chat-toggle>
		<span class="chat__face" aria-hidden="true"><Rubry /><span class="chat__dot"></span></span>
		<span class="chat__label">{t.open}</span>
	</button>
	<script type="application/json" data-chat-data set:html={JSON.stringify(data)} />
</div>

<script>
	import { initChat } from '../scripts/chat';
	initChat();
</script>

<style>
	.chat {
		position: fixed;
		right: clamp(0.75rem, 2vw, 1.5rem);
		bottom: clamp(0.75rem, 2vw, 1.5rem);
		z-index: 90;
		display: grid;
		justify-items: end;
		gap: 0.75rem;
	}

	/* A slim pill, not a bubble: label + live dot. */
	.chat__launcher {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.35rem 1.1rem 0.35rem 0.35rem;
		border: 1px solid var(--hair);
		border-radius: 999px;
		background: var(--surface);
		color: var(--ink);
		font-size: 0.8rem;
		font-weight: 700;
		box-shadow: var(--shadow-soft);
		cursor: pointer;
		transition: border-color 0.25s ease;
	}

	.chat__launcher:hover {
		border-color: var(--ink);
	}

	/* Rubry, our conversational agent, with a live dot. */
	.chat__face {
		position: relative;
		display: grid;
		place-items: center;
		width: 2.3rem;
		height: 2.3rem;
		border-radius: 50%;
		background: var(--paper);
	}

	.chat__face :global(.rubry) {
		width: 1.9rem;
		height: 1.9rem;
		object-fit: contain;
	}

	.chat__dot {
		position: absolute;
		right: 0;
		bottom: 0;
		width: 0.6rem;
		height: 0.6rem;
		border: 2px solid var(--surface);
		border-radius: 50%;
		background: #2fa36b;
	}

	/* Phones: icon-sized pill, so it never sits on page controls. */
	@media (max-width: 640px) {
		.chat__label {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
		}

		.chat__launcher {
			padding: 0.3rem;
		}
	}

	.chat.is-open .chat__label::after {
		content: ' ×';
	}

	.chat__panel {
		display: flex;
		flex-direction: column;
		width: min(22.5rem, calc(100vw - 1.5rem));
		max-height: min(36rem, calc(100svh - 6rem));
		overflow: hidden;
		border: 1px solid var(--hair);
		border-radius: 0.75rem;
		background: var(--surface);
		box-shadow: 0 30px 70px -30px rgba(20, 20, 19, 0.45);
		transform-origin: bottom right;
		animation: chat-in 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.chat__panel[hidden] {
		display: none;
	}

	@keyframes chat-in {
		from {
			opacity: 0;
			transform: translateY(8px) scale(0.98);
		}
	}

	.chat__head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.9rem 1rem;
		border-bottom: 1px solid var(--hair);
	}

	.chat__mark {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.1rem;
		height: 2.1rem;
		border: 1px solid var(--hair);
		border-radius: 50%;
		background: var(--paper);
	}

	.chat__mark :global(.rubry) {
		width: 1.7rem;
		height: 1.7rem;
		object-fit: contain;
	}

	.chat__title {
		font-family: var(--font-display);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.chat__status {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.72rem;
		color: var(--ink-faint);
	}

	.chat__status span {
		width: 0.38rem;
		height: 0.38rem;
		border-radius: 50%;
		background: #2fa36b;
	}

	.chat__icon {
		display: grid;
		place-items: center;
		margin-left: auto;
		width: 2rem;
		height: 2rem;
		color: var(--ink-faint);
		cursor: pointer;
	}

	.chat__icon:hover {
		color: var(--ink);
	}

	.chat__icon svg {
		width: 0.95rem;
		height: 0.95rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.chat__log {
		display: grid;
		align-content: start;
		gap: 0.6rem;
		flex: 1;
		overflow-y: auto;
		padding: 1rem;
		background: var(--paper);
		overscroll-behavior: contain;
	}

	.chat__log > :global(li) {
		display: grid;
		gap: 0.45rem;
		max-width: 88%;
		padding: 0.7rem 0.85rem;
		border: 1px solid var(--hair);
		border-radius: 0.6rem 0.6rem 0.6rem 0.15rem;
		background: var(--surface);
		font-size: 0.86rem;
		line-height: 1.55;
	}

	.chat__log > :global(li.is-me) {
		justify-self: end;
		border-color: transparent;
		border-radius: 0.6rem 0.6rem 0.15rem 0.6rem;
		background: var(--ink);
		color: var(--paper);
	}

	.chat__log :global(ul) {
		display: grid;
		gap: 0.2rem;
		padding-left: 0.9rem;
		list-style: none;
	}

	.chat__log :global(ul li) {
		position: relative;
	}

	.chat__log :global(ul li)::before {
		content: '';
		position: absolute;
		left: -0.8rem;
		top: 0.6em;
		width: 0.5rem;
		height: 0.45rem;
		background: var(--color-brand-500);
		-webkit-mask: var(--ruby-mask);
		mask: var(--ruby-mask);
	}

	.chat__log :global(small) {
		color: var(--ink-faint);
	}

	.chat__log :global(.chat__actions) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.chat__log :global(.chat__actions a) {
		padding: 0.35rem 0.7rem;
		border-radius: 0.25rem;
		background: var(--ink);
		color: var(--paper);
		font-size: 0.78rem;
		font-weight: 700;
	}

	.chat__log :global(.chat__typing) {
		display: flex;
		gap: 0.25rem;
		width: max-content;
	}

	.chat__log :global(.chat__typing i) {
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 50%;
		background: var(--ink-faint);
		animation: chat-dot 1s infinite ease-in-out;
	}

	.chat__log :global(.chat__typing i:nth-child(2)) {
		animation-delay: 0.15s;
	}

	.chat__log :global(.chat__typing i:nth-child(3)) {
		animation-delay: 0.3s;
	}

	@keyframes chat-dot {
		50% {
			opacity: 0.3;
			transform: translateY(-2px);
		}
	}

	.chat__options {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0.8rem 1rem 1rem;
		border-top: 1px solid var(--hair);
	}

	.chat__options :global(button) {
		padding: 0.4rem 0.75rem;
		border: 1px solid var(--hair);
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--ink);
		cursor: pointer;
		transition: border-color 0.2s;
	}

	.chat__options :global(button:hover) {
		border-color: var(--ink);
	}
</style>
