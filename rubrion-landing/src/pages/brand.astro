---
// Brand guide in two tabs: the visual identity (palette, type, mark,
// components and motion, rendered with the live tokens so it can't drift from
// the site) and ready-to-paste descriptions of the business, in both
// languages on either domain, for social profiles and payment gateways.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Mark from '../assets/rubrion-mark.svg';
import { l } from '../data/locale';

const surfaces = [
	['Paper', '--paper', '#F3F2EE'],
	['Surface', '--surface', '#FFFFFF'],
	['Surface 2', '--surface-2', '#E9E7E1'],
	['Ink', '--ink', '#141413'],
	['Ink soft', '--ink-soft', '#57564F'],
	['Slab', '--slab', '#141413'],
];
// The tokens are OKLCH; the hex is the same colour in sRGB, for tools that
// only take hex.
const reds = [
	['Spark 400', 'bg-brand-400', '--color-brand-400', '#FF666A', 'oklch(.71 .19 22)', l({ en: 'Bright coral', pt: 'Coral bem vivo' })],
	['Spark 500', 'bg-brand-500', '--color-brand-500', '#E62B30', 'oklch(.60 .22 26)', l({ en: 'The core red', pt: 'Vermelho central' })],
	['Spark 600', 'bg-brand-600', '--color-brand-600', '#D00016', 'oklch(.54 .22 27)', l({ en: 'Deeper red', pt: 'Vermelho mais fechado' })],
];
const motion = l({
	en: [
		['Ambient shader', 'Warm bands settle out of a strong distortion, then drift; paused off-screen'],
		['Diagonal hero', 'Two projects split by a hairline seam; the next pair dissolves in from the seam'],
		['Diagonal transition', 'A red edge, then paper, sweep across on a slant between main pages'],
		['Split headings', 'Titles rise line by line from a mask'],
		['Digit rollers', 'Each digit rolls into place'],
		['Headroom header', 'Hides while reading down, returns on any scroll up'],
	],
	pt: [
		['Shader ambiente', 'Faixas quentes se assentam a partir de uma distorção forte e depois derivam; pausa fora da tela'],
		['Hero diagonal', 'Dois projetos separados por uma linha fina; o próximo par se dissolve a partir dela'],
		['Transição diagonal', 'Uma borda vermelha e depois o papel atravessam em diagonal entre páginas principais'],
		['Títulos divididos', 'Os títulos sobem linha a linha a partir de uma máscara'],
		['Contadores em rolo', 'Cada dígito rola até o lugar'],
		['Cabeçalho recolhível', 'Some ao descer a página e volta ao subir'],
	],
});
const tabs = l({
	en: { visual: 'Visual identity', about: 'Descriptions', copy: 'Copy', copied: 'Copied' },
	pt: { visual: 'Identidade visual', about: 'Descrições', copy: 'Copiar', copied: 'Copiado' },
});
// Facts only: never "GDPR compliant". Keep the gateway text in step with what
// is actually charged (Rubry sells credits, not subscriptions).
const about: { t: string; hint: string; en: string; pt: string }[] = [
	{
		t: l({ en: 'One line', pt: 'Uma linha' }),
		hint: l({ en: 'Bios, about 150 characters', pt: 'Bios, cerca de 150 caracteres' }),
		en: 'Rubrion builds custom software and AI agents that run on your own infrastructure. Your data stays yours. Based in São Paulo, working worldwide.',
		pt: 'A Rubrion cria software e agentes de IA sob medida que rodam na sua infraestrutura. Seus dados continuam seus. De São Paulo para o mundo.',
	},
	{
		t: l({ en: 'Short', pt: 'Curta' }),
		hint: l({ en: 'LinkedIn tagline, X or Instagram bio', pt: 'Tagline do LinkedIn, bio do X ou Instagram' }),
		en: 'Custom software & AI agents · Your infrastructure, your data · rubrion.ai',
		pt: 'Software e agentes de IA sob medida · Sua infraestrutura, seus dados · rubrion.com.br',
	},
	{
		t: l({ en: 'Medium', pt: 'Média' }),
		hint: l({ en: 'LinkedIn “About”, Google Business, GitHub', pt: '“Sobre” do LinkedIn, Google Meu Negócio, GitHub' }),
		en: 'Rubrion is a software company based in São Paulo, Brazil. We design and build custom software and AI agents for businesses, along with the consulting around them. The agents are trained on the client’s own documents and connected to their systems. Each one runs on the client’s own infrastructure, in their cloud or on-premise, so the data stays theirs. We also make Rubry (rubry.ai), a platform for building and running AI agents. Our aim is high-quality software on lean infrastructure, at a fair price.',
		pt: 'A Rubrion é uma empresa de software de São Paulo. Projetamos e construímos software e agentes de IA sob medida para empresas, junto com a consultoria em torno deles. Os agentes são treinados com os documentos do próprio cliente e conectados aos sistemas dele. Cada um roda na infraestrutura do cliente, na nuvem dele ou on-premise, para que os dados continuem dele. Também criamos o Rubry (rubry.ai), uma plataforma para criar e operar agentes de IA. Nosso objetivo é software de alta qualidade, em infraestrutura enxuta, por um preço justo.',
	},
	{
		t: l({ en: 'Payment gateways', pt: 'Gateways de pagamento' }),
		hint: l({ en: 'Stripe, Asaas, Paddle and similar. Category: software / IT services (MCC 7372)', pt: 'Stripe, Asaas, Paddle e afins. Categoria: software / serviços de TI (MCC 7372)' }),
		en: `RUBRION TECH LTDA (CNPJ 57.637.752/0001-85) develops software and provides IT services to businesses. We sell two things:
1. Custom software and AI agent projects, plus consulting. Each project is quoted in a written proposal or contract and invoiced by milestone or monthly, as agreed. The work is delivered digitally: source code, deployments and documentation.
2. Rubry (rubry.ai), an AI agent platform. Customers buy usage credits online and spend them as their agents run. Delivery is immediate, in the customer’s account. There are no physical goods.
Customers are businesses in Brazil and abroad. Terms: rubrion.ai/terms and rubry.ai/terms. Refunds: rubry.ai/refund. Privacy: rubrion.ai/privacy. Support: hello@rubrion.ai.`,
		pt: `A RUBRION TECH LTDA (CNPJ 57.637.752/0001-85) desenvolve software e presta serviços de TI para empresas. Vendemos duas coisas:
1. Projetos de software e agentes de IA sob medida, e consultoria. Cada projeto é orçado em proposta ou contrato por escrito e faturado por etapa ou mensalmente, conforme acordado. A entrega é digital: código-fonte, implantações e documentação.
2. Rubry (rubry.ai), uma plataforma de agentes de IA. Os clientes compram créditos de uso online e os consomem conforme seus agentes funcionam. A entrega é imediata, na conta do cliente. Não há produtos físicos.
Os clientes são empresas no Brasil e no exterior. Termos: rubrion.com.br/terms e rubry.ai/pt/terms. Reembolsos: rubry.ai/pt/refund. Privacidade: rubrion.com.br/privacy. Suporte: ola@rubrion.com.br.`,
	},
];
// Files in public/brand: the logo (mark + outlined wordmark), the mark alone,
// and square avatars for profiles and gateways. Each as SVG and PNG.
const kit = l({
	en: { logo: 'Logo', mark: 'Mark', avatar: 'Avatar', ink: 'Ink', white: 'White', red: 'Red', paper: 'Paper', square: 'Square, 1024 px PNG: profile photos, payment gateways, app icons', note: 'Use ink on light backgrounds and white on dark ones; keep red for occasional accents. Keep clear space around it of at least half the mark’s height, and don’t stretch, recolour or add effects.' },
	pt: { logo: 'Logo', mark: 'Símbolo', avatar: 'Avatar', ink: 'Tinta', white: 'Branco', red: 'Vermelho', paper: 'Papel', square: 'Quadrado, PNG de 1024 px: fotos de perfil, gateways de pagamento, ícones de app', note: 'Use tinta em fundos claros e branco em fundos escuros; deixe o vermelho para destaques ocasionais. Deixe uma margem livre de pelo menos metade da altura do símbolo, e não estique, mude a cor nem aplique efeitos.' },
});
const files = [
	{ kind: 'logo', variants: [['ink', '#F3F2EE'], ['white', '#141413'], ['red', '#F3F2EE']] },
	{ kind: 'mark', variants: [['ink', '#F3F2EE'], ['white', '#141413'], ['red', '#F3F2EE']] },
	{ kind: 'avatar', variants: [['paper'], ['ink'], ['red']] },
] as const;
const head = (n: string, t: string) => ({ n, t });
const sections = [head('01', 'Palette'), head('02', 'Typography'), head('03', 'Logo'), head('04', 'Components'), head('05', 'Motion')];
---

<Layout title="Brand guide" description="Rubrion brand: palette, type, mark, components and motion.">
	<PageHero
		kicker="Rubrion"
		title={l({ en: 'Brand <em>guide</em>', pt: 'Guia de <em>marca</em>' })}
		lead={l({
			en: 'Warm paper and ink, hairline rules, and one red spark used sparingly: on seams, the eyebrow mark and focus. Never a red surface.',
			pt: 'Papel quente e tinta, linhas finas e uma única faísca vermelha, usada com parcimônia: nas emendas, na marca dos rótulos e no foco. Nunca uma superfície vermelha.',
		})}
		crumbs={[{ label: 'Brand' }]}
	/>

	<div class="mx-auto max-w-5xl px-5 md:px-8">
		<div role="tablist" class="mb-16 flex gap-8 border-b border-hair" data-tabs>
			<button type="button" role="tab" id="tab-visual" aria-controls="visual" aria-selected="true" class="tab">{tabs.visual}</button>
			<button type="button" role="tab" id="tab-descriptions" aria-controls="descriptions" aria-selected="false" tabindex="-1" class="tab">{tabs.about}</button>
		</div>
	</div>

	<div id="visual" role="tabpanel" aria-labelledby="tab-visual" class="mx-auto max-w-5xl space-y-28 px-5 pb-32 md:px-8">
		<section>
			<h2 class="mb-10 flex items-baseline gap-4 border-b border-hair pb-4"><span class="meta">{sections[0].n}</span><span class="display text-3xl">{sections[0].t}</span></h2>
			<div class="grid grid-cols-2 gap-5 sm:grid-cols-3">
				{surfaces.map(([name, token, hex]) => (
					<div>
						<div class="h-24 rounded-md border border-hair" style={`background:var(${token})`}></div>
						<p class="mt-3 text-sm font-bold">{name}</p>
						<p class="text-xs text-ink-faint">{token} · {hex}</p>
					</div>
				))}
			</div>
			<div class="mt-10 grid grid-cols-2 gap-5 sm:grid-cols-3">
				{reds.map(([name, cls, token, hex, v, note]) => (
					<div>
						<div class={`h-14 rounded-md ${cls}`}></div>
						<p class="mt-3 text-sm font-bold">{name} <span class="font-normal text-ink-soft">· {note}</span></p>
						<p class="text-xs text-ink-faint">{token} · {hex}</p>
						<p class="text-xs text-ink-faint">{v}</p>
					</div>
				))}
			</div>
		</section>

		<section>
			<h2 class="mb-10 flex items-baseline gap-4 border-b border-hair pb-4"><span class="meta">{sections[1].n}</span><span class="display text-3xl">{sections[1].t}</span></h2>
			<div class="space-y-8">
				<div class="grid gap-2 border-b border-hair pb-8 md:grid-cols-[10rem_1fr] md:items-baseline">
					<span class="meta">Display · Plus Jakarta</span>
					<p class="display text-5xl md:text-7xl">Code-free, <em>cloud-fee.</em></p>
				</div>
				<div class="grid gap-2 border-b border-hair pb-8 md:grid-cols-[10rem_1fr] md:items-baseline">
					<span class="meta">Accent · Unna italic</span>
					<p class="font-serif text-4xl italic">The one word that matters</p>
				</div>
				<div class="grid gap-2 border-b border-hair pb-8 md:grid-cols-[10rem_1fr] md:items-baseline">
					<span class="meta">Body · Lato</span>
					<p class="lead max-w-xl">High-quality software on lean infrastructure, at a fair price. Lato carries reading text at 1.75 line height.</p>
				</div>
				<div class="grid gap-2 md:grid-cols-[10rem_1fr] md:items-baseline">
					<span class="meta">Eyebrow</span>
					<p class="eyebrow">Section label</p>
				</div>
			</div>
		</section>

		<section>
			<h2 class="mb-10 flex items-baseline gap-4 border-b border-hair pb-4"><span class="meta">{sections[2].n}</span><span class="display text-3xl">{sections[2].t}</span></h2>
			<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
				<div class="flex items-center justify-center rounded-md bg-paper p-12 ring-1 ring-hair">
					<span class="flex items-center gap-2 text-[#141413]"><Mark class="h-8 w-8" /><span class="display text-xl">Rubrion</span></span>
				</div>
				<div class="flex items-center justify-center rounded-md bg-[#141413] p-12">
					<span class="flex items-center gap-2 text-[#f3f2ee]"><Mark class="h-8 w-8" /><span class="display text-xl">Rubrion</span></span>
				</div>
			</div>
			<p class="mt-6 max-w-2xl text-sm text-ink-soft">{kit.note}</p>
			<div class="mt-12 space-y-10">
				{files.map(({ kind, variants }) => (
					<div>
						<p class="meta mb-4">{kit[kind]}</p>
						<div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
							{variants.map(([v, bg]) => {
								const f = `/brand/rubrion-${kind}-${v}`;
								return (
									<div class="card overflow-hidden">
										<div class="flex h-32 items-center justify-center p-6" style={bg ? `background:${bg}` : undefined}>
											<img src={`${f}.svg`} alt={`Rubrion ${kit[kind].toLowerCase()}, ${kit[v].toLowerCase()}`} class={kind === 'logo' ? 'h-10 w-auto' : kind === 'mark' ? 'h-14 w-auto' : 'h-full w-auto rounded-md'} loading="lazy" />
										</div>
										<div class="flex items-center justify-between border-t border-hair px-4 py-3 text-sm">
											<span class="font-bold">{kit[v]}</span>
											<span class="flex gap-4"><a href={`${f}.svg`} download class="link-arrow">SVG</a><a href={`${f}.png`} download class="link-arrow">PNG</a></span>
										</div>
									</div>
								);
							})}
						</div>
						{kind === 'avatar' && <p class="mt-3 text-xs text-ink-faint">{kit.square}</p>}
					</div>
				))}
			</div>
		</section>

		<section>
			<h2 class="mb-10 flex items-baseline gap-4 border-b border-hair pb-4"><span class="meta">{sections[3].n}</span><span class="display text-3xl">{sections[3].t}</span></h2>
			<div class="flex flex-wrap items-center gap-4">
				<a href="#" class="btn btn--ink">Start a project</a>
				<a href="#" class="btn btn--line">See our work</a>
				<a href="#" class="link-arrow">Text link</a>
				<span class="tag-pill">Tag</span>
			</div>
			<div class="mt-8 grid gap-5 sm:grid-cols-2">
				<div class="card p-6"><p class="meta">Card</p><p class="display mt-2 text-xl">Hairline border, no shadow</p></div>
				<div class="rounded-md bg-slab p-6 text-slab-ink"><p class="meta !text-slab-ink/60">Slab</p><p class="display mt-2 text-xl">Contact and footer</p></div>
			</div>
		</section>

		<section>
			<h2 class="mb-10 flex items-baseline gap-4 border-b border-hair pb-4"><span class="meta">{sections[4].n}</span><span class="display text-3xl">{sections[4].t}</span></h2>
			<ul class="grid gap-x-10 sm:grid-cols-2">
				{motion.map(([name, desc]) => (
					<li class="border-b border-hair py-4">
						<p class="font-bold">{name}</p>
						<p class="mt-1 text-sm text-ink-soft">{desc}</p>
					</li>
				))}
			</ul>
		</section>
	</div>

	<div id="descriptions" role="tabpanel" aria-labelledby="tab-descriptions" hidden class="mx-auto max-w-5xl space-y-20 px-5 pb-32 md:px-8">
		{about.map((d, i) => (
			<section>
				<h2 class="mb-8 flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-hair pb-4"><span class="meta">{`0${i + 1}`}</span><span class="display text-3xl">{d.t}</span><span class="text-sm text-ink-faint">{d.hint}</span></h2>
				<div class="grid gap-5 md:grid-cols-2">
					{(['en', 'pt'] as const).map((lang) => (
						<div class="card flex flex-col p-6">
							<div class="mb-4 flex items-center justify-between">
								<span class="meta">{lang === 'en' ? 'English' : 'Português'}</span>
								<button type="button" class="link-arrow text-sm" data-copy data-done={tabs.copied}>{tabs.copy}</button>
							</div>
							<p class="whitespace-pre-line text-[0.98rem] leading-relaxed text-ink-soft" lang={lang === 'en' ? 'en' : 'pt-BR'}>{d[lang]}</p>
						</div>
					))}
				</div>
			</section>
		))}
	</div>
</Layout>

<style>
	.tab {
		margin-bottom: -1px;
		padding: 0.9rem 0;
		border-bottom: 2px solid transparent;
		font-weight: 700;
		color: var(--ink-soft);
		cursor: pointer;
	}
	.tab:hover { color: var(--ink); }
	.tab[aria-selected='true'] {
		color: var(--ink);
		border-bottom-color: var(--color-brand-500);
	}
</style>

<script>
	// Tabs (#descriptions opens the second, so it can be linked) and copy buttons.
	const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tabs] [role=tab]')];
	const show = (tab: HTMLButtonElement) => {
		for (const t of tabs) {
			const on = t === tab;
			t.setAttribute('aria-selected', String(on));
			t.tabIndex = on ? 0 : -1;
			document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
		}
	};
	tabs.forEach((t, i) => {
		t.addEventListener('click', () => {
			show(t);
			history.replaceState(null, '', i ? `#${t.getAttribute('aria-controls')}` : location.pathname);
		});
		t.addEventListener('keydown', (e) => {
			const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
			if (!step) return;
			const next = tabs[(i + step + tabs.length) % tabs.length];
			next.click();
			next.focus();
		});
	});
	const fromHash = tabs.find((t) => `#${t.getAttribute('aria-controls')}` === location.hash);
	if (fromHash) show(fromHash);

	for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
		const label = b.textContent;
		b.addEventListener('click', async () => {
			const text = b.closest('.card')!.querySelector('p:last-child')!.textContent ?? '';
			try {
				await navigator.clipboard.writeText(text);
				b.textContent = b.dataset.done!;
				setTimeout(() => (b.textContent = label), 1500);
			} catch {}
		});
	}
</script>
