---
// Brand guide: palette, type, mark, components and motion, rendered with the
// live tokens so it can't drift from the site.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Mark from '../assets/rubrion-mark.svg';
import { l } from '../data/locale';

const surfaces = [
	['Paper', '--paper', '#F3F2EE'],
	['Surface', '--surface', '#FFFFFF'],
	['Surface 2', '--surface-2', '#E9E7E1'],
	['Ink', '--ink', '#141413'],
	['Ink soft', '--ink-soft', '#57564F'],
	['Slab', '--slab', '#141413'],
];
const reds = [
	['Spark 400', 'bg-brand-400', 'oklch(.71 .19 22)'],
	['Spark 500', 'bg-brand-500', 'oklch(.60 .22 26)'],
	['Spark 600', 'bg-brand-600', 'oklch(.54 .22 27)'],
];
const motion = l({
	en: [
		['Ambient shader', 'Warm bands settle out of a strong distortion, then drift; paused off-screen'],
		['Diagonal hero', 'Two projects split by a hairline seam; the next pair dissolves in from the seam'],
		['Diagonal transition', 'A red edge, then paper, sweep across on a slant between main pages'],
		['Split headings', 'Titles rise line by line from a mask'],
		['Digit rollers', 'Each digit rolls into place'],
		['Headroom header', 'Hides while reading down, returns on any scroll up'],
	],
	pt: [
		['Shader ambiente', 'Faixas quentes se assentam a partir de uma distorção forte e depois derivam; pausa fora da tela'],
		['Hero diagonal', 'Dois projetos separados por uma linha fina; o próximo par se dissolve a partir dela'],
		['Transição diagonal', 'Uma borda vermelha e depois o papel atravessam em diagonal entre páginas principais'],
		['Títulos divididos', 'Os títulos sobem linha a linha a partir de uma máscara'],
		['Contadores em rolo', 'Cada dígito rola até o lugar'],
		['Cabeçalho recolhível', 'Some ao descer a página e volta ao subir'],
	],
});
const head = (n: string, t: string) => ({ n, t });
const sections = [head('01', 'Palette'), head('02', 'Typography'), head('03', 'Mark'), head('04', 'Components'), head('05', 'Motion')];
---

<Layout title="Brand guide" description="Rubrion brand: palette, type, mark, components and motion.">
	<PageHero
		kicker="Rubrion"
		title={l({ en: 'Brand <em>guide</em>', pt: 'Guia de <em>marca</em>' })}
		lead={l({
			en: 'Warm paper and ink, hairline rules, and one red spark used sparingly: on seams, the eyebrow mark and focus. Never a red surface.',
			pt: 'Papel quente e tinta, linhas finas e uma única faísca vermelha, usada com parcimônia: nas emendas, na marca dos rótulos e no foco. Nunca uma superfície vermelha.',
		})}
		crumbs={[{ label: 'Brand' }]}
	/>

	<div class="mx-auto max-w-5xl space-y-28 px-5 pb-32 md:px-8">
		<section>
			<h2 class="mb-10 flex items-baseline gap-4 border-b border-hair pb-4"><span class="meta">{sections[0].n}</span><span class="display text-3xl">{sections[0].t}</span></h2>
			<div class="grid grid-cols-2 gap-5 sm:grid-cols-3">
				{surfaces.map(([name, token, hex]) => (
					<div>
						<div class="h-24 rounded-md border border-hair" style={`background:var(${token})`}></div>
						<p class="mt-3 text-sm font-bold">{name}</p>
						<p class="text-xs text-ink-faint">{token} · {hex}</p>
					</div>
				))}
			</div>
			<div class="mt-10 grid grid-cols-3 gap-5">
				{reds.map(([name, cls, v]) => (
					<div>
						<div class={`h-14 rounded-md ${cls}`}></div>
						<p class="mt-3 text-sm font-bold">{name}</p>
						<p class="text-xs text-ink-faint">{v}</p>
					</div>
				))}
			</div>
		</section>

		<section>
			<h2 class="mb-10 flex items-baseline gap-4 border-b border-hair pb-4"><span class="meta">{sections[1].n}</span><span class="display text-3xl">{sections[1].t}</span></h2>
			<div class="space-y-8">
				<div class="grid gap-2 border-b border-hair pb-8 md:grid-cols-[10rem_1fr] md:items-baseline">
					<span class="meta">Display · Plus Jakarta</span>
					<p class="display text-5xl md:text-7xl">Code-free, <em>cloud-fee.</em></p>
				</div>
				<div class="grid gap-2 border-b border-hair pb-8 md:grid-cols-[10rem_1fr] md:items-baseline">
					<span class="meta">Accent · Unna italic</span>
					<p class="font-serif text-4xl italic">The one word that matters</p>
				</div>
				<div class="grid gap-2 border-b border-hair pb-8 md:grid-cols-[10rem_1fr] md:items-baseline">
					<span class="meta">Body · Lato</span>
					<p class="lead max-w-xl">High-quality software on lean infrastructure, at a fair price. Lato carries reading text at 1.75 line height.</p>
				</div>
				<div class="grid gap-2 md:grid-cols-[10rem_1fr] md:items-baseline">
					<span class="meta">Eyebrow</span>
					<p class="eyebrow">Section label</p>
				</div>
			</div>
		</section>

		<section>
			<h2 class="mb-10 flex items-baseline gap-4 border-b border-hair pb-4"><span class="meta">{sections[2].n}</span><span class="display text-3xl">{sections[2].t}</span></h2>
			<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
				<div class="flex items-center justify-center rounded-md bg-paper p-12 ring-1 ring-hair">
					<span class="flex items-center gap-2 text-[#141413]"><Mark class="h-8 w-8" /><span class="display text-xl">Rubrion</span></span>
				</div>
				<div class="flex items-center justify-center rounded-md bg-[#141413] p-12">
					<span class="flex items-center gap-2 text-[#f3f2ee]"><Mark class="h-8 w-8" /><span class="display text-xl">Rubrion</span></span>
				</div>
			</div>
		</section>

		<section>
			<h2 class="mb-10 flex items-baseline gap-4 border-b border-hair pb-4"><span class="meta">{sections[3].n}</span><span class="display text-3xl">{sections[3].t}</span></h2>
			<div class="flex flex-wrap items-center gap-4">
				<a href="#" class="btn btn--ink">Start a project</a>
				<a href="#" class="btn btn--line">See our work</a>
				<a href="#" class="link-arrow">Text link</a>
				<span class="tag-pill">Tag</span>
			</div>
			<div class="mt-8 grid gap-5 sm:grid-cols-2">
				<div class="card p-6"><p class="meta">Card</p><p class="display mt-2 text-xl">Hairline border, no shadow</p></div>
				<div class="rounded-md bg-slab p-6 text-slab-ink"><p class="meta !text-slab-ink/60">Slab</p><p class="display mt-2 text-xl">Contact and footer</p></div>
			</div>
		</section>

		<section>
			<h2 class="mb-10 flex items-baseline gap-4 border-b border-hair pb-4"><span class="meta">{sections[4].n}</span><span class="display text-3xl">{sections[4].t}</span></h2>
			<ul class="grid gap-x-10 sm:grid-cols-2">
				{motion.map(([name, desc]) => (
					<li class="border-b border-hair py-4">
						<p class="font-bold">{name}</p>
						<p class="mt-1 text-sm text-ink-soft">{desc}</p>
					</li>
				))}
			</ul>
		</section>
	</div>
</Layout>
