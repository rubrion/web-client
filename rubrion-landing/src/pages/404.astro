---
import Layout from '../layouts/Layout.astro';
import Mark from '../assets/rubrion-mark.svg';
import { c } from '../data/site';
---

<Layout title="404" noindex>
	<section class="relative flex min-h-[100svh] items-center justify-center overflow-hidden bg-paper px-5 text-center">
		<canvas class="absolute inset-0 h-full w-full" data-ambient="paper" aria-hidden="true"></canvas>
		<Mark class="pointer-events-none absolute h-[70vh] w-[70vh] text-ink/[0.04]" aria-hidden="true" />
		<div class="relative">
			<p class="display text-[clamp(6rem,22vw,14rem)] leading-none">4<em>0</em>4</p>
			<h1 class="display mx-auto mt-6 max-w-xl text-3xl md:text-[2.6rem]" set:html={c.notFound.title} />
			<p class="lead mx-auto mt-5 max-w-md">{c.notFound.lead}</p>
			<a href="/" class="btn btn--ink mt-10">{c.notFound.cta}</a>
		</div>
	</section>
</Layout>
