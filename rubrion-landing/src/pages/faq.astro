---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { FAQS, buildFaqSchema } from '../data/seo';
---

<Layout
	title="Rubrion, FAQ"
	description="Why Rubrion: how fast we ship, how pricing works, who owns the source, and where we host."
	jsonLd={[buildFaqSchema(FAQS)]}
>
	<Navbar />
	<main class="pt-24">
		<Faq />
	</main>
	<Footer />
</Layout>
