---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import { FAQS, buildFaqSchema } from '../data/seo';
import { c } from '../data/site';
---

<Layout title={c.nav.faq} description={c.faq.lead} jsonLd={[buildFaqSchema(FAQS)]}>
	<PageHero kicker={c.faq.kicker} title={c.faq.title} lead={c.faq.lead} crumbs={[{ label: c.nav.faq }]} />
	<Faq head={false} />
</Layout>
