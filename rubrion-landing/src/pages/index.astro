---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Partners from '../components/Partners.astro';
import Services from '../components/Services.astro';
import SectionHead from '../components/SectionHead.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Build from '../components/Build.astro';
import BlogTeaser from '../components/BlogTeaser.astro';
import Contact from '../components/Contact.astro';
import { c } from '../data/site';
import { heroWork } from '../data/work';

const first = heroWork[0].image;
---

<Layout overlay turnstile>
	<Fragment slot="head">
		<link rel="preload" as="image" href={`/work/${first}-1600.webp`} imagesrcset={`/work/${first}-900.webp 900w, /work/${first}-1600.webp 1600w`} imagesizes="100vw" fetchpriority="high" />
	</Fragment>
	<Hero />
	<Partners />
	<Services />
	<section id="work" class="bg-surface px-5 py-28 md:px-8 md:py-40">
		<div class="mx-auto max-w-7xl">
			<div class="flex flex-wrap items-end justify-between gap-6">
				<SectionHead kicker={c.work.kicker} title={c.work.title} lead={c.work.lead} />
				<a href="/work" data-reveal class="link-arrow link-arrow--in">{c.work.allWork}</a>
			</div>
			<WorkGrid limit={6} filters={false} />
		</div>
	</section>
	<Build />
	<BlogTeaser />
	<Contact />
</Layout>
