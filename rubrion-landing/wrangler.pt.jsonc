{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-06-21",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "rubrion-landing-pt",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Unknown paths get the branded 404 page (with a real 404 status).
		"not_found_handling": "404-page"
	},
	// Astro sessions KV binding injected by @astrojs/cloudflare. Bound to the
	// existing PT namespace by id so wrangler does not auto-provision on deploy.
	"kv_namespaces": [
		{ "binding": "SESSION", "id": "725dc3d131c14e0f898f22bae7ae73b6" }
	],
	"observability": {
		"enabled": true
	}
}