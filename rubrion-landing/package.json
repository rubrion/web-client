{
	"name": "rubrion-landing",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"dev:pt": "SITE_LOCALE=pt astro dev",
		"build": "npm run build:en && npm run build:pt && node tools/merge-pt.mjs",
		"build:en": "SITE_LOCALE=en astro build",
		"build:pt": "SITE_LOCALE=pt astro build --outDir dist-pt",
		"preview": "wrangler dev",
		"check": "astro check",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.3",
		"@fontsource/lato": "^5.3.0",
		"@fontsource/plus-jakarta-sans": "^5.2.8",
		"@fontsource/unna": "^5.3.0",
		"@tailwindcss/vite": "^4.3.1",
		"astro": "^7.4.0",
		"cobe": "^2.0.1",
		"gsap": "^3.15.0",
		"lenis": "^1.3.27",
		"tailwindcss": "^4.3.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"typescript": "^6.0.3",
		"wrangler": "^4.151.1"
	}
}
