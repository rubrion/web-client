{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-06-21",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "rubrion-landing",
	// One Worker, both sites: English at the root of ./dist, Portuguese under
	// ./dist/__pt (npm run build). worker/index.ts picks the language by host.
	"main": "worker/index.ts",
	// Keep workers.dev and per-version preview URLs for reviewing uploads.
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		// Unknown English paths get the branded 404 page (with a real 404).
		"not_found_handling": "404-page"
	},
	"routes": [
		{ "pattern": "rubrion.ai", "custom_domain": true },
		{ "pattern": "www.rubrion.ai", "custom_domain": true },
		{ "pattern": "rubrion.com.br", "custom_domain": true },
		{ "pattern": "www.rubrion.com.br", "custom_domain": true }
	],
	// The newsletter backend (EdgeLetter): POST /api/subscribe forwards here.
	"services": [{ "binding": "EDGELETTER", "service": "web-rubrion-edgeletter" }],
	// Secrets: NEWSLETTER_TURNSTILE_SECRET (the "edgepress" widget, same as
	// EdgeLetter's) and SUBSCRIBE_API_KEY (shared with EdgeLetter).
	"observability": {
		"enabled": true
	}
}
